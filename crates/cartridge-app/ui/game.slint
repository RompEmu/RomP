import { Theme } from "theme.slint";
export struct PortRow { label: string, device: string }

component MenuButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> focused;
    callback clicked();
    height: 40px;
    border-radius: 8px;
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.accent-text;
    background: root.primary
        ? (touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : (touch.pressed ? Theme.surface-raised : touch.has-hover ? Theme.surface-selected : Theme.surface-muted);
    animate background { duration: 100ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    Text {
        text: root.text;
        color: Theme.text-strong;
        font-size: Theme.font-body-large;
        font-weight: root.primary ? 600 : 500;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component GameMenu inherits Rectangle {
    in property <string> name;
    in property <bool> paused;
    in property <int> slot;
    in property <bool> fullscreen;
    in property <int> focused-item: -1;
    in property <[PortRow]> ports;
    in property <string> menu-key: "Esc";
    callback cycle-port(int, int);
    callback resume();
    callback toggle-pause();
    callback save-state();
    callback load-state();
    callback step-slot(int);
    callback toggle-fullscreen();
    callback open-controllers();
    callback quit();

    background: Theme.scrim;
    TouchArea { }
    Rectangle {
        width: 340px;
        height: menu.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface-raised;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border-subtle;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        menu := VerticalLayout {
            padding: 22px;
            spacing: 10px;
            Text { text: root.name; color: Theme.text-strong; font-size: Theme.font-subtitle; font-weight: 700; overflow: elide; }
            Text { text: root.paused ? @tr("Paused") : @tr("Running behind this menu"); color: Theme.text-muted; font-size: Theme.font-body; }
            Rectangle { height: 4px; }
            MenuButton { text: @tr("Resume"); primary: true; focused: root.focused-item == 0; clicked => { root.resume(); } }
            MenuButton { text: root.paused ? @tr("Play") : @tr("Pause"); focused: root.focused-item == 1; clicked => { root.toggle-pause(); } }
            Rectangle { height: 1px; background: Theme.hover; }
            HorizontalLayout {
                spacing: 8px;
                Text { text: @tr("Save slot"); color: Theme.text-secondary; vertical-alignment: center; horizontal-stretch: 1; }
                MenuButton { width: 40px; text: "‹"; clicked => { root.step-slot(-1); } }
                Rectangle {
                    width: 36px;
                    border-radius: 8px;
                    border-width: root.focused-item == 2 ? 2px : 0px;
                    border-color: Theme.accent-text;
                    Text { text: root.slot; color: Theme.text-strong; font-size: Theme.font-subtitle; font-weight: 700; }
                }
                MenuButton { width: 40px; text: "›"; clicked => { root.step-slot(1); } }
            }
            HorizontalLayout {
                spacing: 8px;
                MenuButton { text: @tr("Save state"); focused: root.focused-item == 3; clicked => { root.save-state(); } }
                MenuButton { text: @tr("Load state"); focused: root.focused-item == 4; clicked => { root.load-state(); } }
            }
            Rectangle { height: 1px; background: Theme.hover; }
            MenuButton { text: root.fullscreen ? @tr("Exit full screen") : @tr("Full screen"); focused: root.focused-item == 5; clicked => { root.toggle-fullscreen(); } }
            MenuButton { text: @tr("Controllers…"); focused: root.focused-item == 6; clicked => { root.open-controllers(); } }
            for port[i] in root.ports: HorizontalLayout {
                spacing: 8px;
                Text { text: port.label; color: Theme.text-secondary; vertical-alignment: center; width: 56px; }
                MenuButton { width: 40px; text: "‹"; clicked => { root.cycle-port(i, -1); } }
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    background: Theme.surface-muted;
                    border-width: root.focused-item == 7 + i ? 2px : 0px;
                    border-color: Theme.accent-text;
                    Text { text: port.device; color: Theme.text-strong; font-size: Theme.font-body-large; overflow: elide; }
                }
                MenuButton { width: 40px; text: "›"; clicked => { root.cycle-port(i, 1); } }
            }
            MenuButton { text: @tr("Quit game"); focused: root.focused-item == 7 + root.ports.length; clicked => { root.quit(); } }
            VerticalLayout {
                padding-top: 4px;
                spacing: 2px;
                Text { text: root.menu-key == "Esc" ? @tr("Esc or Guide resume  ·  P pause  ·  F11 full screen") : @tr("F12 or Guide resume  ·  your keyboard goes to the game"); color: Theme.text-subtle; font-size: Theme.font-caption; horizontal-alignment: center; }
                if root.menu-key == "Esc": Text { text: @tr("F5 save  ·  F7 load  ·  F6 next slot"); color: Theme.text-subtle; font-size: Theme.font-caption; horizontal-alignment: center; }
            }
        }
    }
}

export component GameWindow inherits Window {
    in property <string> game-title: "Cartridge";
    in property <string> game-name;
    in property <bool> has-menu;
    in property <bool> menu-open;
    in property <bool> paused;
    in property <int> slot: 1;
    in property <bool> fullscreen;
    in property <bool> sharp: true;
    in property <int> menu-focus: -1;
    in property <bool> mouse-mode;
    in property <bool> mouse-captured;
    in property <bool> lightgun-mode;
    in property <string> menu-key: "Esc";
    in property <[PortRow]> ports;
    callback cycle-port(int, int);
    callback capture-mouse();
    callback mouse-button(int, bool);
    callback window-active(bool);
    callback resume();
    callback toggle-pause();
    callback save-state();
    callback load-state();
    callback step-slot(int);
    callback toggle-fullscreen();
    callback open-controllers();
    callback quit();
    in property <image> frame;
    in property <float> aspect: 4 / 3;
    in property <string> status;
    callback key-event(string, bool, bool) -> bool;
    callback pointer(float, float, bool);
    callback focus-lost();

    title: root.game-title;
    preferred-width: 960px;
    preferred-height: 720px;
    background: black;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            return root.key-event(event.text, true, event.repeat) ? EventResult.accept : EventResult.reject;
        }
        focus-lost(reason) => {
            root.focus-lost();
            if reason == FocusReason.window-activation {
                root.window-active(false);
            }
        }
        focus-gained(reason) => {
            if reason == FocusReason.window-activation {
                root.window-active(true);
            }
        }
        key-released(event) => {
            return root.key-event(event.text, false, false) ? EventResult.accept : EventResult.reject;
        }

        frame := Image {
            source: root.frame;
            image-fit: fill;
            image-rendering: root.sharp ? ImageRendering.pixelated : ImageRendering.smooth;
            width: min(parent.width, parent.height * root.aspect);
            height: self.width / root.aspect;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        TouchArea {
            x: frame.x;
            y: frame.y;
            width: frame.width;
            height: frame.height;
            mouse-cursor: root.lightgun-mode ? MouseCursor.crosshair : MouseCursor.default;
            pointer-event(event) => {
                if root.lightgun-mode {
                    root.pointer(self.mouse-x / self.width, self.mouse-y / self.height, false);
                    if event.kind != PointerEventKind.move {
                        root.mouse-button(
                            event.button == PointerEventButton.left ? 1 : event.button == PointerEventButton.right ? 2 : event.button == PointerEventButton.middle ? 4 : 0,
                            event.kind == PointerEventKind.down);
                    }
                    return;
                }
                if root.mouse-mode {
                    if event.kind == PointerEventKind.move {
                        return;
                    }
                    if !root.mouse-captured {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            root.capture-mouse();
                        }
                        return;
                    }
                    root.mouse-button(
                        event.button == PointerEventButton.left ? 1 : event.button == PointerEventButton.right ? 2 : event.button == PointerEventButton.middle ? 4 : 0,
                        event.kind == PointerEventKind.down);
                    return;
                }
                if event.button == PointerEventButton.left && event.kind != PointerEventKind.move {
                    root.pointer(self.mouse-x / self.width, self.mouse-y / self.height, event.kind == PointerEventKind.down);
                }
            }
            moved => {
                if self.pressed && !root.mouse-mode {
                    root.pointer(self.mouse-x / self.width, self.mouse-y / self.height, true);
                }
            }
        }

        if root.paused && !root.menu-open: Rectangle {
            x: (parent.width - self.width) / 2;
            y: 16px;
            width: paused-label.preferred-width + 28px;
            height: 32px;
            border-radius: 16px;
            background: Theme.scrim-strong;
            paused-label := Text { text: root.menu-key == "Esc" ? @tr("Paused  ·  P to resume") : @tr("Paused  ·  {} for the menu", root.menu-key); color: Theme.text-strong; font-size: Theme.font-body-large; }
        }

        if root.has-menu && root.menu-open: GameMenu {
            width: parent.width;
            height: parent.height;
            name: root.game-name;
            paused: root.paused;
            slot: root.slot;
            fullscreen: root.fullscreen;
            focused-item: root.menu-focus;
            ports: root.ports;
            menu-key: root.menu-key;
            cycle-port(i, step) => { root.cycle-port(i, step); }
            resume => { root.resume(); }
            toggle-pause => { root.toggle-pause(); }
            save-state => { root.save-state(); }
            load-state => { root.load-state(); }
            step-slot(d) => { root.step-slot(d); }
            toggle-fullscreen => { root.toggle-fullscreen(); }
            open-controllers => { root.open-controllers(); }
            quit => { root.quit(); }
        }

        if root.status != "": Rectangle {
            x: 16px;
            y: parent.height - self.height - 16px;
            width: parent.width - 32px;
            height: label.preferred-height + 16px;
            background: Theme.scrim-strong;
            border-radius: 6px;
            label := Text {
                x: 8px;
                width: parent.width - 16px;
                text: root.status;
                color: Theme.text-strong;
                font-size: Theme.font-body-large;
                wrap: word-wrap;
            }
        }
    }
}
