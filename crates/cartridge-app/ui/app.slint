import { Button, CheckBox, ComboBox, LineEdit, ListView, ProgressIndicator, ScrollView, Slider, Spinner, Switch } from "std-widgets.slint";

export struct SidebarEntry { header: bool, key: string, name: string, count: int, icon: image, has-icon: bool, glyph: string, expanded: bool, can-add: bool, editable: bool }
export struct Membership { key: string, name: string, member: bool }
export struct DeviceRow { key: string, name: string, detail: string, player: int, active: bool }
export struct StorageRow { label: string, size: string }
export struct KeyHint { keys: string, action: string }
export struct RemapRow { name: string, binding: string, waiting: bool }
export struct GameCard { id: int, title: string, platform: string, cover: image, has-cover: bool, downloaded: bool, focused: bool }
export struct GameRow { cards: [GameCard] }
export struct Fact { label: string, value: string }
export struct Shot { image: image, loaded: bool }

component Connect inherits Rectangle {
    in-out property <string> server-url;
    in property <string> error;
    in property <bool> busy;
    callback connect();

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 420px;
                spacing: 14px;
                Text { text: "Connect to RomM"; font-size: 26px; font-weight: 700; }
                Text { text: "Enter the address of your RomM server."; color: #888; }
                url := LineEdit {
                    placeholder-text: "romm.example.com";
                    text <=> root.server-url;
                    enabled: !root.busy;
                    accepted => { root.connect(); }
                }
                if root.error != "": Text { text: root.error; color: #e5484d; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    if root.busy: Spinner { indeterminate: true; width: 24px; height: 24px; }
                    Button {
                        text: "Continue";
                        primary: true;
                        enabled: !root.busy && root.server-url != "";
                        clicked => { root.connect(); }
                    }
                }
            }
        }
    }
    init => { url.focus(); }
}

component Pairing inherits Rectangle {
    in property <image> qr;
    in property <string> link;
    in property <string> user-code;
    in property <int> seconds-left;
    in property <string> status;
    in property <bool> failed;
    callback copy-link();
    callback open-link();
    callback cancel();
    callback retry();

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 460px;
                spacing: 14px;
                Text { text: "Approve this device"; font-size: 26px; font-weight: 700; }
                Text {
                    text: "Scan the code or open the link on a device signed in to RomM, then approve Cartridge.";
                    color: #888;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    Image { source: root.qr; width: 220px; height: 220px; image-rendering: pixelated; }
                }
                HorizontalLayout {
                    alignment: center;
                    Text { text: root.user-code; font-size: 30px; font-weight: 700; letter-spacing: 4px; }
                }
                Text { text: root.link; horizontal-alignment: center; color: #888; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Button { text: "Copy link"; clicked => { root.copy-link(); } }
                    Button { text: "Open in browser"; clicked => { root.open-link(); } }
                }
                Text {
                    horizontal-alignment: center;
                    color: root.failed ? #e5484d : #888;
                    text: root.status != "" ? root.status
                        : "Waiting for approval… (" + floor(root.seconds-left / 60) + ":"
                          + (mod(root.seconds-left, 60) < 10 ? "0" : "") + mod(root.seconds-left, 60) + ")";
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Button { text: "Back"; clicked => { root.cancel(); } }
                    if root.failed: Button { text: "Try again"; primary: true; clicked => { root.retry(); } }
                }
            }
        }
    }
}


component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <bool> selected;
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> glyph;
    callback clicked();
    height: 34px;
    border-radius: 6px;
    background: root.selected ? #3a3f4b : touch.has-hover ? #2a2e36 : transparent;
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            width: 20px;
            if root.has-icon: Image { source: root.icon; width: 20px; height: 20px; image-fit: contain; }
            if !root.has-icon: Text { text: root.glyph; color: #e5484d; font-size: 14px; }
        }
        Text { text: root.label; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: root.count; vertical-alignment: center; color: #888; }
    }
}

component SectionHeader inherits Rectangle {
    in property <string> label;
    in property <bool> expanded;
    in property <bool> can-add;
    callback toggled();
    callback add();
    height: 32px;
    touch := TouchArea { clicked => { root.toggled(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        padding-top: 8px;
        spacing: 6px;
        Rectangle {
            width: 10px;
            Path {
                width: 6px;
                height: 6px;
                commands: root.expanded ? "M 0 2 L 8 2 L 4 7 Z" : "M 2 0 L 7 4 L 2 8 Z";
                fill: #6b7280;
            }
        }
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            color: touch.has-hover ? #c9d1d9 : #7d8590;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.can-add: Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 4px;
            background: add-touch.has-hover ? #2a2e36 : transparent;
            Text { text: "+"; font-size: 16px; color: #c9d1d9; }
            add-touch := TouchArea { clicked => { root.add(); } }
        }
    }
}

component Card inherits Rectangle {
    in property <GameCard> game;
    callback clicked();
    width: 172px;
    height: 290px;
    touch := TouchArea { clicked => { root.clicked(); } }
    VerticalLayout {
        alignment: start;
        spacing: 6px;
        Rectangle {
            height: 230px;
            border-radius: 8px;
            clip: true;
            background: #2a2e36;
            if root.game.has-cover: Image {
                source: root.game.cover;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
            if !root.game.has-cover: Text {
                text: root.game.title;
                color: #aaa;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width - 16px;
                x: 8px;
            }
            if root.game.downloaded: Rectangle {
                x: parent.width - self.width - 8px;
                y: 8px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: #2f9e44;
                Text { text: "✓"; color: white; font-weight: 700; }
            }
            if touch.has-hover: Rectangle { background: #ffffff14; }
            if root.game.focused: Rectangle {
                border-radius: 8px;
                border-width: 3px;
                border-color: #8b9cff;
            }
        }
        Text { text: root.game.title; overflow: elide; font-weight: 600; }
        HorizontalLayout {
            spacing: 4px;
            Text { text: root.game.platform; overflow: elide; color: #888; font-size: 12px; horizontal-stretch: 1; }
            Text {
                text: root.game.downloaded ? "Downloaded" : "On server";
                color: root.game.downloaded ? #40c057 : #777;
                font-size: 12px;
                font-weight: root.game.downloaded ? 600 : 400;
            }
        }
    }
}

component Library inherits Rectangle {
    in property <string> user-label;
    in property <[SidebarEntry]> sidebar;
    in property <string> selected-key;
    in property <[GameRow]> rows;
    in property <string> sync-status;
    in property <bool> syncing;
    in-out property <string> search;
    callback select(string);
    callback toggle-section(string);
    callback new-collection();
    callback rename-collection(string);
    callback delete-collection(string);
    callback search-edited(string);
    callback columns-changed(int);
    callback row-shown(int);
    callback refresh();
    callback open-settings();
    callback open-game(int);
    in property <bool> needs-pairing;
    in property <string> pair-prompt;
    callback pair-again();
    in-out property <bool> downloaded-only;
    in property <bool> offline;
    callback downloaded-only-toggled(bool);
    in property <int> focus-row: -1;
    changed focus-row => {
        if root.focus-row >= 0 {
            if root.focus-row * 306px < -games.content-y {
                games.content-y = -(root.focus-row * 306px);
            }
            if (root.focus-row + 1) * 306px > -games.content-y + games.visible-height {
                games.content-y = -((root.focus-row + 1) * 306px - games.visible-height);
            }
        }
    }

    HorizontalLayout {
        Rectangle {
            width: 240px;
            background: #1b1e24;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                Text { text: "Cartridge"; font-size: 20px; font-weight: 700; }
                Rectangle { height: 8px; }
                ListView {
                    vertical-stretch: 1;
                    for e in root.sidebar: HorizontalLayout {
                        padding-right: 14px;
                        if e.header: SectionHeader {
                            label: e.name;
                            expanded: e.expanded;
                            can-add: e.can-add;
                            toggled => { root.toggle-section(e.key); }
                            add => { root.new-collection(); }
                        }
                        if !e.header && e.editable: ContextMenuArea {
                            height: 34px;
                            Menu {
                                MenuItem { title: "Rename…"; activated => { root.rename-collection(e.key); } }
                                MenuItem { title: "Delete…"; activated => { root.delete-collection(e.key); } }
                            }
                            SidebarItem {
                                width: parent.width;
                                label: e.name;
                                count: e.count;
                                icon: e.icon;
                                has-icon: e.has-icon;
                                glyph: e.glyph;
                                selected: root.selected-key == e.key;
                                clicked => { root.select(e.key); }
                            }
                        }
                        if !e.header && !e.editable: SidebarItem {
                            label: e.name;
                            count: e.count;
                            icon: e.icon;
                            has-icon: e.has-icon;
                            glyph: e.glyph;
                            selected: root.selected-key == e.key;
                            clicked => { root.select(e.key); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.user-label; color: #888; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                    Button { text: "Settings"; clicked => { root.open-settings(); } }
                }
            }
        }
        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 10px;
                LineEdit {
                    placeholder-text: "Search";
                    text <=> root.search;
                    edited(text) => { root.search-edited(text); }
                }
                Switch {
                    text: "Downloaded only";
                    checked <=> root.downloaded-only;
                    enabled: !root.offline;
                    toggled => { root.downloaded-only-toggled(self.checked); }
                }
                if root.needs-pairing: Button { text: root.pair-prompt; clicked => { root.pair-again(); } }
                Text { text: root.sync-status; color: #888; vertical-alignment: center; }
                if root.syncing: Spinner { indeterminate: true; width: 20px; height: 20px; }
                Button { text: "Refresh"; enabled: !root.syncing; clicked => { root.refresh(); } }
            }
            grid := Rectangle {
                vertical-stretch: 1;
                property <int> columns: max(1, floor((self.width - 24px) / 188px));
                changed columns => { root.columns-changed(self.columns); }
                init => { root.columns-changed(self.columns); }
                if root.rows.length == 0: Text {
                    text: root.syncing ? "Loading your library…" : "No games found.";
                    color: #888;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                games := ListView {
                    for row[i] in root.rows: HorizontalLayout {
                        property <int> index: i;
                        padding: 8px;
                        spacing: 16px;
                        alignment: start;
                        init => { root.row-shown(i); }
                        changed index => { root.row-shown(self.index); }
                        for game in row.cards: Card {
                            game: game;
                            clicked => { root.open-game(game.id); }
                        }
                    }
                }
            }
        }
    }
}


component SectionTitle inherits Text {
    font-size: 17px;
    font-weight: 700;
    color: #e6e8eb;
}

component GamePage inherits Rectangle {
    in property <string> title;
    in property <string> category;
    in property <string> subtitle;
    in property <string> summary;
    in property <[Fact]> facts;
    in property <[Shot]> shots;
    in property <[GameCard]> similar;
    in property <image> cover;
    in property <bool> has-cover;
    in property <bool> downloaded;
    in property <bool> busy;
    in property <bool> playable;
    in property <bool> can-download;
    in property <float> progress;
    in property <string> status;
    in property <bool> conflict;
    in property <string> conflict-text;
    callback keep-local();
    callback keep-server();
    callback back();
    callback download();
    callback cancel();
    callback play();
    callback delete();
    callback open-game(int);
    in property <bool> show-collections;
    in property <bool> can-edit-collections;
    in property <bool> favorite;
    in property <[Membership]> memberships;
    callback toggle-favorite();
    callback toggle-membership(string, bool);
    callback new-collection();

    property <int> viewing: -1;
    changed title => { self.viewing = -1; page.content-y = 0; }

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px;
            padding-bottom: 8px;
            alignment: start;
            Button { text: "← Library"; clicked => { root.back(); } }
        }
        page := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: page.visible-width;
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 8px;
                padding-bottom: 32px;
                spacing: 32px;
                HorizontalLayout {
                    spacing: 28px;
                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: 260px;
                            height: 347px;
                            border-radius: 10px;
                            clip: true;
                            background: #2a2e36;
                            if root.has-cover: Image { source: root.cover; width: parent.width; height: parent.height; image-fit: contain; }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: 10px;
                        if root.category != "": Text {
                            text: root.category;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 1.5px;
                            color: #8b9cff;
                        }
                        Text { text: root.title; font-size: 30px; font-weight: 800; wrap: word-wrap; }
                        Text { text: root.subtitle; font-size: 15px; color: #9aa3b2; wrap: word-wrap; }
                        HorizontalLayout {
                            padding-top: 8px;
                            alignment: start;
                            spacing: 10px;
                            if !root.downloaded && !root.busy && root.playable: Button {
                                text: "Download";
                                primary: true;
                                enabled: root.can-download;
                                clicked => { root.download(); }
                            }
                            if root.busy: ProgressIndicator { width: 220px; progress: root.progress; }
                            if root.busy: Button { text: "Cancel"; clicked => { root.cancel(); } }
                            if root.downloaded && !root.busy: Button { text: "Play"; primary: true; clicked => { root.play(); } }
                            if root.downloaded && !root.busy: Button { text: "Delete download"; clicked => { root.delete(); } }
                            if root.show-collections: Button {
                                text: root.favorite ? "♥ In favorites" : "♡ Add to favorites";
                                enabled: root.can-edit-collections;
                                clicked => { root.toggle-favorite(); }
                            }
                            if root.show-collections: Rectangle {
                                width: collections-button.preferred-width;
                                collections-button := Button {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "Collections…";
                                    enabled: root.can-edit-collections;
                                    clicked => { collections-popup.show(); }
                                }
                                collections-popup := PopupWindow {
                                    y: parent.height + 4px;
                                    close-policy: close-on-click-outside;
                                    Rectangle {
                                        background: #23272f;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #3a3f4b;
                                        drop-shadow-blur: 12px;
                                        drop-shadow-color: #00000080;
                                        VerticalLayout {
                                            width: 260px;
                                            padding: 12px;
                                            spacing: 6px;
                                            if root.memberships.length == 0: Text {
                                                text: "You don't have any collections yet.";
                                                color: #8a8f98;
                                                wrap: word-wrap;
                                            }
                                            for m in root.memberships: CheckBox {
                                                text: m.name;
                                                checked: m.member;
                                                toggled => { root.toggle-membership(m.key, self.checked); }
                                            }
                                            Button {
                                                text: "New collection…";
                                                clicked => {
                                                    collections-popup.close();
                                                    root.new-collection();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.status != "": Text { text: root.status; color: #bbb; wrap: word-wrap; }
                        if root.conflict: Rectangle {
                            border-radius: 8px;
                            background: #3b2f1e;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: "Your save changed on this computer and on the server."; font-weight: 700; wrap: word-wrap; }
                                Text { text: root.conflict-text; color: #ccc; wrap: word-wrap; }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 10px;
                                    Button { text: "Use this computer's save"; clicked => { root.keep-local(); } }
                                    Button { text: "Use the server's save"; clicked => { root.keep-server(); } }
                                }
                            }
                        }
                        VerticalLayout {
                            padding-top: 14px;
                            spacing: 9px;
                            for fact in root.facts: HorizontalLayout {
                                spacing: 16px;
                                Text { text: fact.label; width: 96px; font-size: 13px; color: #8a8f98; }
                                Text { text: fact.value; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
                if root.summary != "": VerticalLayout {
                    spacing: 10px;
                    SectionTitle { text: "Overview"; }
                    HorizontalLayout {
                        alignment: start;
                        Text { text: root.summary; max-width: 780px; wrap: word-wrap; font-size: 14px; color: #cfd3da; }
                    }
                }
                if root.shots.length > 0: VerticalLayout {
                    spacing: 10px;
                    SectionTitle { text: "Screenshots"; }
                    shots-view := ScrollView {
                        height: 214px;
                        content-width: shot-row.preferred-width;
                        content-height: self.visible-height;
                        shot-row := HorizontalLayout {
                            spacing: 12px;
                            padding-bottom: 14px;
                            for shot[i] in root.shots: Rectangle {
                                width: 266px;
                                height: 200px;
                                border-radius: 8px;
                                clip: true;
                                background: #2a2e36;
                                if shot.loaded: Image { source: shot.image; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
                                shot-touch := TouchArea { clicked => { root.viewing = i; } }
                                if shot-touch.has-hover: Rectangle { background: #ffffff14; }
                            }
                        }
                    }
                }
                if root.similar.length > 0: VerticalLayout {
                    spacing: 10px;
                    SectionTitle { text: "Similar in your library"; }
                    ScrollView {
                        height: 304px;
                        content-width: similar-row.preferred-width;
                        content-height: self.visible-height;
                        similar-row := HorizontalLayout {
                            spacing: 16px;
                            padding-bottom: 14px;
                            for game in root.similar: Card {
                                game: game;
                                clicked => { root.open-game(game.id); }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.viewing >= 0 && root.viewing < root.shots.length: Rectangle {
        background: #000000e6;
        TouchArea { clicked => { root.viewing = -1; } }
        Image {
            x: 72px;
            y: 48px;
            width: parent.width - 144px;
            height: parent.height - 96px;
            source: root.shots[root.viewing].image;
            image-fit: contain;
        }
        if root.viewing > 0: Button {
            x: 16px;
            y: (parent.height - self.height) / 2;
            text: "‹";
            clicked => { root.viewing -= 1; }
        }
        if root.viewing < root.shots.length - 1: Button {
            x: parent.width - self.width - 16px;
            y: (parent.height - self.height) / 2;
            text: "›";
            clicked => { root.viewing += 1; }
        }
        Button {
            x: parent.width - self.width - 16px;
            y: 12px;
            text: "Close";
            clicked => { root.viewing = -1; }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 34px;
    border-radius: 6px;
    background: root.selected ? #3a3f4b : touch.has-hover ? #2a2e36 : transparent;
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px;
        Text { text: root.label; vertical-alignment: center; font-weight: root.selected ? 600 : 400; }
    }
}

component Panel inherits Rectangle {
    clip: true;
    background: #23272f;
    border-radius: 10px;
    border-width: 1px;
    border-color: #2f343d;
    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        @children
    }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> divider;
    in property <bool> highlight;
    in property <color> detail-color: #8a8f98;
    background: root.highlight ? #2b3a55 : transparent;
    animate background { duration: 150ms; }
    VerticalLayout {
        if root.divider: Rectangle { height: 1px; background: #2f343d; }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text { text: root.label; font-size: 14px; overflow: elide; }
                if root.detail != "": Text { text: root.detail; font-size: 12px; color: root.detail-color; wrap: word-wrap; }
            }
            @children
        }
    }
}

component SectionHeading inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 4px;
    padding-bottom: 4px;
    Text { text: root.title; font-size: 22px; font-weight: 700; }
    if root.subtitle != "": Text { text: root.subtitle; color: #8a8f98; wrap: word-wrap; }
}

component SettingsPage inherits Rectangle {
    in-out property <int> section;
    in property <string> user;
    in property <string> server;
    in property <bool> offline;
    in property <[DeviceRow]> devices;
    in property <[KeyHint]> keys;
    in property <[StorageRow]> storage;
    in property <string> storage-total;
    in property <bool> storage-busy;
    in-out property <bool> pause-unfocused;
    in-out property <bool> resume;
    in-out property <bool> fullscreen;
    in-out property <bool> sharp;
    in-out property <float> volume;
    callback prefs-changed();
    in-out property <bool> nintendo-labels;
    in-out property <bool> stick-dpad;
    callback controller-options-changed();
    in property <bool> remap-open;
    in property <string> remap-title;
    in property <string> remap-hint;
    in property <bool> remap-waiting;
    in property <[RemapRow]> remap-rows;
    callback customize(string);
    callback remap-pick(int);
    callback remap-key(string);
    callback remap-reset();
    callback remap-close();
    callback back();
    callback sign-out();
    callback pair-again();
    callback assign(string, int);
    callback clear-images();
    callback show-folder();
    callback section-changed(int);

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px;
            padding-bottom: 8px;
            alignment: start;
            Button { text: "← Library"; clicked => { root.back(); } }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            VerticalLayout {
                width: 220px;
                padding-left: 24px;
                padding-right: 16px;
                padding-top: 16px;
                spacing: 2px;
                alignment: start;
                Text { text: "Settings"; font-size: 13px; font-weight: 700; color: #7d8590; letter-spacing: 1px; }
                Rectangle { height: 8px; }
                for label[i] in ["General", "Account", "Players", "Storage"]: NavItem {
                    label: label;
                    selected: root.section == i;
                    clicked => { root.section = i; root.section-changed(i); }
                }
            }
            content := ScrollView {
                horizontal-stretch: 1;
                content-width: self.visible-width;
                content-height: body.preferred-height;
                body := VerticalLayout {
                    width: min(content.visible-width, 760px);
                    padding-left: 8px;
                    padding-right: 24px;
                    padding-top: 16px;
                    padding-bottom: 32px;
                    spacing: 16px;
                    if root.section == 0: VerticalLayout {
                        spacing: 16px;
                        SectionHeading { title: "General"; subtitle: "How games behave on this computer."; }
                        Panel {
                            SettingRow {
                                label: "Pause when the game window isn't focused";
                                detail: "Switching to another window pauses the game. Coming back resumes it.";
                                Switch { checked <=> root.pause-unfocused; toggled => { root.prefs-changed(); } }
                            }
                            SettingRow {
                                divider: true;
                                label: "Resume where you left off";
                                detail: "Starting a game continues from the automatic save made when you last quit it.";
                                Switch { checked <=> root.resume; toggled => { root.prefs-changed(); } }
                            }
                            SettingRow {
                                divider: true;
                                label: "Start games in full screen";
                                detail: "Press F11 in a game to switch at any time.";
                                Switch { checked <=> root.fullscreen; toggled => { root.prefs-changed(); } }
                            }
                            SettingRow {
                                divider: true;
                                label: "Sharp pixels";
                                detail: "Keeps pixel art crisp. Turn off for smoother scaling.";
                                Switch { checked <=> root.sharp; toggled => { root.prefs-changed(); } }
                            }
                            SettingRow {
                                divider: true;
                                label: "Game volume";
                                detail: round(root.volume) + "%";
                                Slider {
                                    width: 200px;
                                    minimum: 0;
                                    maximum: 100;
                                    value <=> root.volume;
                                    changed => { root.prefs-changed(); }
                                }
                            }
                        }
                    }
                    if root.section == 1: VerticalLayout {
                        spacing: 16px;
                        SectionHeading { title: "Account"; subtitle: "Your RomM server and this device's access to it."; }
                        Panel {
                            SettingRow { label: "Signed in as"; detail: root.user != "" ? root.user : "Unknown"; }
                            SettingRow {
                                divider: true;
                                label: "Server";
                                detail: root.server + (root.offline ? "  ·  Offline" : "");
                            }
                            SettingRow {
                                divider: true;
                                label: "Device access";
                                detail: "Approve this device again, for example after an update that needs new permissions.";
                                Button { text: "Pair again"; enabled: !root.offline; clicked => { root.pair-again(); } }
                            }
                            SettingRow {
                                divider: true;
                                label: "Sign out";
                                detail: "Signs this device out and clears the library list. Downloaded files stay on disk.";
                                Button { text: "Sign out"; clicked => { root.sign-out(); } }
                            }
                        }
                    }
                    if root.section == 2: VerticalLayout {
                        spacing: 16px;
                        SectionHeading {
                            title: "Players";
                            subtitle: "Choose which player each controller plays as. Press a button on a controller to find it here.";
                        }
                        Panel {
                            for device[i] in root.devices: SettingRow {
                                divider: i > 0;
                                label: device.name;
                                detail: device.active ? "Button pressed" : device.detail;
                                detail-color: device.active ? #8b9cff : #8a8f98;
                                highlight: device.active;
                                Button { text: "Customize…"; clicked => { root.customize(device.key); } }
                                ComboBox {
                                    width: 150px;
                                    model: ["Off", "Player 1", "Player 2", "Player 3", "Player 4"];
                                    current-index: device.player;
                                    selected => { root.assign(device.key, self.current-index); }
                                }
                            }
                        }
                        Text { text: "Controller options"; font-size: 15px; font-weight: 700; }
                        Panel {
                            SettingRow {
                                label: "Match button labels on Nintendo systems";
                                detail: "On other controllers, the button labelled A presses A instead of the one in its place on a Nintendo pad.";
                                Switch { checked <=> root.nintendo-labels; toggled => { root.controller-options-changed(); } }
                            }
                            SettingRow {
                                divider: true;
                                label: "Left stick also moves the D-pad";
                                detail: "Handy for games made for a D-pad.";
                                Switch { checked <=> root.stick-dpad; toggled => { root.controller-options-changed(); } }
                            }
                        }
                        Text { text: "Shortcuts"; font-size: 15px; font-weight: 700; }
                        Panel {
                            for hint[i] in root.keys: SettingRow {
                                divider: i > 0;
                                label: hint.action;
                                Rectangle {
                                    width: key-text.preferred-width + 16px;
                                    height: 24px;
                                    border-radius: 5px;
                                    background: #2f343d;
                                    key-text := Text { text: hint.keys; font-size: 12px; color: #d0d4da; }
                                }
                            }
                        }
                    }
                    if root.section == 3: VerticalLayout {
                        spacing: 16px;
                        SectionHeading {
                            title: "Storage";
                            subtitle: root.storage-busy ? "Measuring…" : "Space used on this computer: " + root.storage-total + ".";
                        }
                        Panel {
                            for row[i] in root.storage: SettingRow {
                                divider: i > 0;
                                label: row.label;
                                Text { text: row.size; color: #b8bec8; vertical-alignment: center; }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 10px;
                            Button { text: "Clear image cache"; clicked => { root.clear-images(); } }
                            Button { text: "Show folder"; clicked => { root.show-folder(); } }
                        }
                    }
                }
            }
        }
    }

    if root.remap-open: Rectangle {
        background: #000000a0;
        TouchArea { }
        Rectangle {
            width: 480px;
            height: min(parent.height - 64px, remap-box.preferred-height);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #23272f;
            border-radius: 12px;
            border-width: 1px;
            border-color: #3a3f4b;
            clip: true;
            remap-keys := FocusScope {
                key-pressed(event) => {
                    if root.remap-waiting {
                        root.remap-key(event.text);
                        return accept;
                    }
                    return reject;
                }
                remap-box := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text { text: root.remap-title; font-size: 17px; font-weight: 700; }
                    Text { text: root.remap-hint; color: #b8bec8; wrap: word-wrap; }
                    ScrollView {
                        vertical-stretch: 1;
                        min-height: 200px;
                        preferred-height: remap-list.preferred-height;
                        content-width: self.visible-width;
                        content-height: remap-list.preferred-height;
                        remap-list := VerticalLayout {
                            width: parent.width;
                            for row[i] in root.remap-rows: SettingRow {
                                divider: i > 0;
                                label: row.name;
                                highlight: row.waiting;
                                Button {
                                    width: 190px;
                                    text: row.waiting ? "Press…" : row.binding;
                                    clicked => {
                                        root.remap-pick(i);
                                        remap-keys.focus();
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Button { text: "Reset to default"; clicked => { root.remap-reset(); } }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Done"; primary: true; clicked => { root.remap-close(); } }
                    }
                }
            }
        }
    }
}

component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <bool> asks-name;
    in-out property <string> value;
    in property <string> confirm-label;
    in property <bool> destructive;
    callback accepted(string);
    callback cancelled();
    background: #000000a0;
    TouchArea { }
    Rectangle {
        width: 380px;
        height: box.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #23272f;
        border-radius: 10px;
        border-width: 1px;
        border-color: #3a3f4b;
        box := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: root.title; font-size: 17px; font-weight: 700; }
            if root.message != "": Text { text: root.message; color: #b8bec8; wrap: word-wrap; }
            if root.asks-name: LineEdit {
                text <=> root.value;
                accepted => { if root.value != "" { root.accepted(root.value); } }
                init => { self.focus(); }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                Button { text: "Cancel"; clicked => { root.cancelled(); } }
                Button {
                    text: root.confirm-label;
                    primary: !root.destructive;
                    enabled: !root.asks-name || root.value != "";
                    clicked => { root.accepted(root.value); }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Cartridge";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 640px;
    min-height: 480px;

    in property <int> screen;

    in-out property <string> server-url;
    in property <string> connect-error;
    in property <bool> busy;
    callback connect();

    in property <image> qr;
    in property <string> pair-link;
    in property <string> user-code;
    in-out property <int> seconds-left;
    in property <string> pair-status;
    in property <bool> pair-failed;
    callback copy-link();
    callback open-link();
    callback cancel-pairing();
    callback retry-pairing();

    in property <string> user-label;
    callback sign-out();
    callback open-settings();
    in-out property <int> settings-section;
    in property <string> settings-server;
    in property <[DeviceRow]> settings-devices;
    in property <[KeyHint]> settings-keys;
    in property <[StorageRow]> settings-storage;
    in property <string> settings-storage-total;
    in property <bool> settings-storage-busy;
    callback assign-player(string, int);
    callback clear-images();
    callback show-folder();
    callback settings-section-changed(int);
    in-out property <bool> pref-pause-unfocused;
    in-out property <bool> pref-resume;
    in-out property <bool> pref-fullscreen;
    in-out property <bool> pref-sharp;
    in-out property <float> pref-volume;
    callback prefs-changed();
    in-out property <bool> pref-nintendo-labels;
    in-out property <bool> pref-stick-dpad;
    callback controller-options-changed();
    in property <bool> remap-open;
    in property <string> remap-title;
    in property <string> remap-hint;
    in property <bool> remap-waiting;
    in property <[RemapRow]> remap-rows;
    callback customize(string);
    callback remap-pick(int);
    callback remap-key(string);
    callback remap-reset();
    callback remap-close();

    in property <[SidebarEntry]> sidebar;
    in property <string> selected-key: "all";
    in property <[GameRow]> rows;
    in property <string> sync-status;
    in property <bool> syncing;
    in-out property <string> search;
    callback select(string);
    callback toggle-section(string);
    callback new-collection();
    callback rename-collection(string);
    callback delete-collection(string);
    callback search-edited(string);
    callback columns-changed(int);
    callback row-shown(int);
    callback refresh();
    callback open-game(int);

    in property <string> game-title;
    in property <string> game-category;
    in property <string> game-subtitle;
    in property <string> game-summary;
    in property <[Fact]> game-facts;
    in property <[Shot]> game-shots;
    in property <[GameCard]> game-similar;
    in property <image> game-cover;
    in property <bool> has-game-cover;
    in property <bool> game-downloaded;
    in property <bool> game-busy;
    in property <bool> game-playable;
    in property <bool> game-can-download;
    in property <float> game-progress;
    in property <string> game-status;
    callback back-to-library();
    callback download-game();
    callback cancel-download();
    callback play-game();
    callback delete-game();
    in property <bool> save-conflict;
    in property <string> conflict-text;
    callback keep-local-save();
    callback keep-server-save();
    in property <bool> needs-pairing;
    in property <string> pair-prompt;
    callback pair-again();
    in property <bool> show-collections;
    in property <bool> can-edit-collections;
    in property <bool> game-favorite;
    in property <[Membership]> game-memberships;
    callback toggle-favorite();
    callback toggle-membership(string, bool);
    callback new-collection-with-game();
    in property <int> grid-focus-row: -1;
    in property <string> pad-hints;
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-message;
    in property <bool> dialog-asks-name;
    in-out property <string> dialog-value;
    in property <string> dialog-confirm;
    in property <bool> dialog-destructive;
    callback dialog-accepted(string);
    callback dialog-cancelled();
    in-out property <bool> downloaded-only;
    in property <bool> offline;
    callback downloaded-only-toggled(bool);

    if root.screen == 0: Connect {
        server-url <=> root.server-url;
        error: root.connect-error;
        busy: root.busy;
        connect => { root.connect(); }
    }
    if root.screen == 1: Pairing {
        qr: root.qr;
        link: root.pair-link;
        user-code: root.user-code;
        seconds-left: root.seconds-left;
        status: root.pair-status;
        failed: root.pair-failed;
        copy-link => { root.copy-link(); }
        open-link => { root.open-link(); }
        cancel => { root.cancel-pairing(); }
        retry => { root.retry-pairing(); }
    }
    Library {
        visible: root.screen == 2;
        user-label: root.user-label;
        sidebar: root.sidebar;
        selected-key: root.selected-key;
        rows: root.rows;
        sync-status: root.sync-status;
        syncing: root.syncing;
        search <=> root.search;
        select(key) => { root.select(key); }
        toggle-section(key) => { root.toggle-section(key); }
        new-collection => { root.new-collection(); }
        rename-collection(key) => { root.rename-collection(key); }
        delete-collection(key) => { root.delete-collection(key); }
        search-edited(text) => { root.search-edited(text); }
        columns-changed(n) => { root.columns-changed(n); }
        row-shown(i) => { root.row-shown(i); }
        refresh => { root.refresh(); }
        open-game(id) => { root.open-game(id); }
        needs-pairing: root.needs-pairing;
        pair-prompt: root.pair-prompt;
        pair-again => { root.pair-again(); }
        downloaded-only <=> root.downloaded-only;
        offline: root.offline;
        downloaded-only-toggled(on) => { root.downloaded-only-toggled(on); }
        open-settings => { root.open-settings(); }
        focus-row: root.grid-focus-row;
    }
    if root.screen == 4: SettingsPage {
        section <=> root.settings-section;
        user: root.user-label;
        server: root.settings-server;
        offline: root.offline;
        devices: root.settings-devices;
        keys: root.settings-keys;
        storage: root.settings-storage;
        storage-total: root.settings-storage-total;
        storage-busy: root.settings-storage-busy;
        pause-unfocused <=> root.pref-pause-unfocused;
        resume <=> root.pref-resume;
        fullscreen <=> root.pref-fullscreen;
        sharp <=> root.pref-sharp;
        volume <=> root.pref-volume;
        prefs-changed => { root.prefs-changed(); }
        nintendo-labels <=> root.pref-nintendo-labels;
        stick-dpad <=> root.pref-stick-dpad;
        controller-options-changed => { root.controller-options-changed(); }
        remap-open: root.remap-open;
        remap-title: root.remap-title;
        remap-hint: root.remap-hint;
        remap-waiting: root.remap-waiting;
        remap-rows: root.remap-rows;
        customize(key) => { root.customize(key); }
        remap-pick(i) => { root.remap-pick(i); }
        remap-key(text) => { root.remap-key(text); }
        remap-reset => { root.remap-reset(); }
        remap-close => { root.remap-close(); }
        back => { root.back-to-library(); }
        sign-out => { root.sign-out(); }
        pair-again => { root.pair-again(); }
        assign(key, player) => { root.assign-player(key, player); }
        clear-images => { root.clear-images(); }
        show-folder => { root.show-folder(); }
        section-changed(i) => { root.settings-section-changed(i); }
    }
    if root.screen == 3: GamePage {
        title: root.game-title;
        category: root.game-category;
        subtitle: root.game-subtitle;
        summary: root.game-summary;
        facts: root.game-facts;
        shots: root.game-shots;
        similar: root.game-similar;
        open-game(id) => { root.open-game(id); }
        cover: root.game-cover;
        has-cover: root.has-game-cover;
        downloaded: root.game-downloaded;
        busy: root.game-busy;
        playable: root.game-playable;
        can-download: root.game-can-download;
        progress: root.game-progress;
        status: root.game-status;
        back => { root.back-to-library(); }
        download => { root.download-game(); }
        cancel => { root.cancel-download(); }
        play => { root.play-game(); }
        delete => { root.delete-game(); }
        conflict: root.save-conflict;
        conflict-text: root.conflict-text;
        keep-local => { root.keep-local-save(); }
        keep-server => { root.keep-server-save(); }
        show-collections: root.show-collections;
        can-edit-collections: root.can-edit-collections;
        favorite: root.game-favorite;
        memberships: root.game-memberships;
        toggle-favorite => { root.toggle-favorite(); }
        toggle-membership(key, on) => { root.toggle-membership(key, on); }
        new-collection => { root.new-collection-with-game(); }
    }
    if root.pad-hints != "" && !root.dialog-open: Rectangle {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 12px;
        width: hints-text.preferred-width + 24px;
        height: 30px;
        border-radius: 15px;
        background: #000000c8;
        border-width: 1px;
        border-color: #ffffff1a;
        hints-text := Text { text: root.pad-hints; color: #d0d4da; font-size: 12px; }
    }
    if root.dialog-open: Dialog {
        title: root.dialog-title;
        message: root.dialog-message;
        asks-name: root.dialog-asks-name;
        value <=> root.dialog-value;
        confirm-label: root.dialog-confirm;
        destructive: root.dialog-destructive;
        accepted(value) => { root.dialog-accepted(value); }
        cancelled => { root.dialog-cancelled(); }
    }
}
