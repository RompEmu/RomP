import { Locale, Row, Theme } from "theme.slint";
import { AchievementItem, AchievementRow } from "achievements.slint";
import { SlotCard, SlotPicture } from "slots.slint";
import { Button, ScrollView } from "std-widgets.slint";
export struct PortRow { label: string, device: string }
export struct LookRow { label: string, value: string }

component KeyCap inherits Rectangle {
    in property <string> text;
    in property <bool> on-accent;
    height: 20px;
    width: max(22px, cap-text.preferred-width + 10px);
    border-radius: 5px;
    border-width: 1px;
    border-color: root.on-accent ? Theme.accent-foreground.with-alpha(0.35) : Theme.border-subtle;
    background: root.on-accent ? Theme.accent-foreground.with-alpha(0.08) : Theme.hover;
    cap-text := Text { horizontal-alignment: Locale.start;
        text: root.text;
        font-size: Theme.font-caption;
        font-weight: 600;
        color: root.on-accent ? Theme.accent-foreground.with-alpha(0.75) : Theme.text-muted;
    }
}

component MenuRow inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <string> shortcut;
    in property <bool> focused;
    in property <bool> danger;
    callback clicked();
    height: 32px;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.pressed : root.focused ? Theme.accent-soft : touch.has-hover ? Theme.hover : transparent;
    border-width: root.focused ? 1px : 0px;
    border-color: Theme.accent;
    animate background { duration: 100ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea { clicked => { root.clicked(); } }
    Row {
        cross-axis-alignment: CrossAxisAlignment.center;
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;
        Image {
            source: root.icon;
            width: 18px;
            height: 18px;
            colorize: root.danger ? Theme.danger : root.focused || touch.has-hover ? Theme.text-strong : Theme.text-secondary;
        }
        Text { horizontal-alignment: Locale.start;
            text: root.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            font-size: Theme.font-body-large;
            font-weight: root.focused ? 600 : 500;
            color: root.danger ? Theme.danger : Theme.text-strong;
        }
        if root.shortcut != "": VerticalLayout {
            alignment: center;
            KeyCap { text: root.shortcut; }
        }
    }
}

component StepButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: Theme.radius-small;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    Text { horizontal-alignment: Locale.start; text: root.text; font-size: Theme.font-title; color: touch.has-hover ? Theme.text-strong : Theme.text-secondary; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

/// A RetroAchievements popup: an unlock, or news about the connection or a leaderboard.
component AchievementToast inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <image> badge;
    in property <bool> has-badge;
    height: toast-row.preferred-height;
    background: Theme.scrim-strong;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    toast-row := HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        if root.has-badge && !Locale.rtl: Image {
            source: root.badge;
            width: 48px;
            height: 48px;
            image-fit: contain;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { horizontal-alignment: Locale.start; text: root.title; color: Theme.text-strong; font-size: Theme.font-body-large; font-weight: 700; wrap: word-wrap; }
            Text { horizontal-alignment: Locale.start; text: root.detail; color: Theme.text-secondary; font-size: Theme.font-body; wrap: word-wrap; }
        }
        if root.has-badge && Locale.rtl: Image {
            source: root.badge;
            width: 48px;
            height: 48px;
            image-fit: contain;
        }
    }
}

component Stepper inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> focused;
    callback step(int);
    height: 32px;
    border-radius: Theme.radius;
    background: root.focused ? Theme.accent-soft : transparent;
    border-width: root.focused ? 1px : 0px;
    border-color: Theme.accent;
    Row {
        padding-left: 12px;
        padding-right: 5px;
        spacing: 4px;
        Text { horizontal-alignment: Locale.start;
            text: root.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            font-size: Theme.font-body-large;
            color: Theme.text-secondary;
        }
        VerticalLayout {
            alignment: center;
            StepButton { text: Locale.rtl ? "›" : "‹"; clicked => { root.step(-1); } }
        }
        Text {
            text: root.value;
            min-width: 24px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            font-size: Theme.font-body-large;
            font-weight: 600;
            color: Theme.text-strong;
        }
        VerticalLayout {
            alignment: center;
            StepButton { text: Locale.rtl ? "‹" : "›"; clicked => { root.step(1); } }
        }
    }
}

component ChipButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <string> shortcut;
    in property <bool> focused;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px;
    min-width: chip.preferred-width;
    opacity: root.enabled ? 1.0 : 0.4;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.pressed : root.focused ? Theme.accent-soft : touch.has-hover ? Theme.surface-selected : Theme.surface-muted;
    border-width: root.focused ? 1px : 0px;
    border-color: Theme.accent;
    animate background { duration: 100ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    chip := Row {
        cross-axis-alignment: CrossAxisAlignment.center;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;
        if root.icon.width > 0: Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            colorize: root.focused || touch.has-hover ? Theme.text-strong : Theme.text-secondary;
        }
        Text { horizontal-alignment: Locale.start;
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.font-body;
            font-weight: 500;
            color: Theme.text-strong;
        }
        if root.shortcut != "": VerticalLayout {
            alignment: center;
            KeyCap { text: root.shortcut; }
        }
    }
}

component MenuDivider inherits Rectangle {
    height: 7px;
    Rectangle { height: 1px; background: Theme.divider; }
}

component GameMenu inherits Rectangle {
    in property <string> name;
    in property <bool> paused;
    in property <int> volume;
    in property <bool> fullscreen;
    in property <int> focused-item: -1;
    in property <[PortRow]> ports;
    in property <string> menu-key: "Esc";
    in property <string> pause-key: "P";
    in property <string> save-key: "F5";
    in property <string> load-key: "F7";
    in property <string> slot-key: "F6";
    in property <string> guide-name: "Guide";
    in property <string> fullscreen-key: "F11";
    in property <string> screenshot-key: "F12";
    callback cycle-port(int, int);
    callback resume();
    callback toggle-pause();
    callback restart();
    callback step-volume(int);
    callback toggle-fullscreen();
    callback take-screenshot();
    callback open-controllers();
    callback quit();
    in property <bool> has-achievements;
    in property <string> achievements-label;
    in property <bool> hardcore;
    callback open-achievements();
    callback open-slots();
    in property <string> look-label;
    callback open-look();

    property <bool> keyboard: root.menu-key == "Esc";

    background: Theme.scrim;
    TouchArea { }
    Rectangle {
        width: 360px;
        height: menu.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface-raised;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border-subtle;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.shadow;
        menu := VerticalLayout {
            padding: 12px;
            padding-top: 14px;
            spacing: 2px;
            Row {
                padding-left: 6px;
                padding-right: 6px;
                padding-bottom: 8px;
                spacing: 8px;
                Text { horizontal-alignment: Locale.start;
                    text: root.name;
                    color: Theme.text-strong;
                    font-size: Theme.font-subtitle;
                    font-weight: 700;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: root.paused ? Theme.warning : Theme.success;
                    }
                }
                Text { horizontal-alignment: Locale.start;
                    text: root.paused ? @tr("Paused") : @tr("Running");
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }
            Row {
                spacing: 6px;
                Rectangle {
                    height: 34px;
                    horizontal-stretch: 1;
                    border-radius: Theme.radius;
                    background: resume-touch.pressed ? Theme.accent-pressed : resume-touch.has-hover ? Theme.accent-hover : Theme.accent;
                    border-width: root.focused-item == 0 ? 2px : 0px;
                    border-color: Theme.accent-text;
                    accessible-role: button;
                    accessible-label: @tr("Resume");
                    accessible-action-default => { root.resume(); }
                    resume-touch := TouchArea { clicked => { root.resume(); } }
                    Row {
                        cross-axis-alignment: CrossAxisAlignment.center;
                        padding-left: 12px;
                        padding-right: 10px;
                        spacing: 12px;
                        Image {
                            source: @image-url("icons/play.svg");
                            width: 18px;
                            height: 18px;
                            colorize: Theme.accent-foreground;
                        }
                        Text { horizontal-alignment: Locale.start;
                            text: @tr("Resume");
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-size: Theme.font-body-large;
                            font-weight: 700;
                            color: Theme.accent-foreground;
                        }
                        VerticalLayout {
                            alignment: center;
                            KeyCap { text: root.menu-key; on-accent: true; }
                        }
                    }
                }
                ChipButton {
                    text: root.paused ? @tr("Play") : @tr("Pause");
                    icon: root.paused ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                    focused: root.focused-item == 1;
                    clicked => { root.toggle-pause(); }
                }
                ChipButton {
                    text: @tr("Restart");
                    icon: @image-url("icons/refresh.svg");
                    focused: root.focused-item == 2;
                    clicked => { root.restart(); }
                }
            }
            MenuRow {
                text: @tr("Save states");
                icon: @image-url("icons/save.svg");
                shortcut: root.keyboard ? root.save-key + " / " + root.load-key : "";
                focused: root.focused-item == 3;
                clicked => { root.open-slots(); }
            }
            MenuRow {
                text: @tr("Look  ·  {}", root.look-label);
                icon: @image-url("icons/screen.svg");
                focused: root.focused-item == 4;
                clicked => { root.open-look(); }
            }
            if root.hardcore: Text { horizontal-alignment: Locale.start;
                text: @tr("Hardcore mode: loading states is off.");
                color: Theme.text-subtle;
                font-size: Theme.font-caption;
            }
            MenuDivider { }
            Stepper {
                label: @tr("Volume");
                value: root.volume + "%";
                focused: root.focused-item == 5;
                step(d) => { root.step-volume(d); }
            }
            MenuRow {
                text: root.fullscreen ? @tr("Exit full screen") : @tr("Full screen");
                icon: root.fullscreen ? @image-url("icons/exit-fullscreen.svg") : @image-url("icons/fullscreen.svg");
                shortcut: root.keyboard ? root.fullscreen-key : "";
                focused: root.focused-item == 6;
                clicked => { root.toggle-fullscreen(); }
            }
            MenuRow {
                text: @tr("Take screenshot");
                icon: @image-url("icons/camera.svg");
                shortcut: root.keyboard ? root.screenshot-key : "";
                focused: root.focused-item == 7;
                clicked => { root.take-screenshot(); }
            }
            MenuRow {
                text: root.has-achievements ? @tr("Achievements  ·  {}", root.achievements-label) : @tr("Achievements  ·  sign in under Settings");
                icon: @image-url("icons/trophy.svg");
                focused: root.focused-item == 8;
                clicked => { root.open-achievements(); }
            }
            MenuRow {
                text: @tr("Controllers…");
                icon: @image-url("icons/gamepad.svg");
                focused: root.focused-item == 9;
                clicked => { root.open-controllers(); }
            }
            for port[i] in root.ports: Stepper {
                label: port.label;
                value: port.device;
                focused: root.focused-item == 10 + i;
                step(d) => { root.cycle-port(i, d); }
            }
            MenuDivider { }
            MenuRow {
                text: @tr("Quit game");
                icon: @image-url("icons/quit.svg");
                danger: true;
                focused: root.focused-item == 10 + root.ports.length;
                clicked => { root.quit(); }
            }
            Text {
                text: root.keyboard ? @tr("{} next slot  ·  {} opens this menu", root.slot-key, root.guide-name) : @tr("Keyboard goes to the game  ·  {} opens this menu", root.guide-name);
                color: Theme.text-subtle;
                font-size: Theme.font-caption;
                horizontal-alignment: center;
                wrap: word-wrap;
                height: self.preferred-height + 6px;
                vertical-alignment: bottom;
            }
        }
    }
}

/// One save slot in the game menu: its picture, when it was saved, and what to do with it.
component SlotTile inherits Rectangle {
    in property <SlotCard> card;
    in property <bool> focused;
    in property <bool> load-focused;
    in property <bool> hardcore;
    callback save(int);
    callback load(int);
    horizontal-stretch: 1;
    height: tile-box.preferred-height;
    border-radius: 10px;
    background: root.focused ? Theme.accent-soft : Theme.surface-muted;
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.accent;
    tile-box := VerticalLayout {
        padding: 8px;
        spacing: 6px;
        SlotPicture { card: root.card; height: self.width * 0.62; }
        Row {
            spacing: 6px;
            Text { horizontal-alignment: Locale.start; text: root.card.label; font-weight: 700; font-size: Theme.font-body; color: Theme.text-strong; }
            if root.card.current: Text { horizontal-alignment: Locale.start; text: @tr("current"); font-size: Theme.font-caption; color: Theme.accent; vertical-alignment: center; }
        }
        Text { horizontal-alignment: Locale.start; text: root.card.detail; font-size: Theme.font-small; color: Theme.text-muted; }
        Row {
            spacing: 6px;
            ChipButton {
                text: @tr("Save");
                horizontal-stretch: 1;
                focused: root.focused && !root.load-focused;
                clicked => { root.save(root.card.slot); }
            }
            ChipButton {
                text: @tr("Load");
                horizontal-stretch: 1;
                enabled: !root.card.empty && !root.hardcore;
                focused: root.focused && root.load-focused;
                clicked => { root.load(root.card.slot); }
            }
        }
    }
}

/// Chooses how the game is drawn, while it stays visible above.
component LookPanel inherits Rectangle {
    in property <[LookRow]> rows;
    in property <int> focused-row;
    callback step(int, int);
    callback close();
    height: look-box.preferred-height;
    background: Theme.surface-raised.with-alpha(0.94);
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    TouchArea { }
    look-box := VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Row {
            padding-left: 6px;
            padding-bottom: 4px;
            Text { horizontal-alignment: Locale.start; text: @tr("Look"); font-size: Theme.font-subtitle; font-weight: 700; color: Theme.text-strong; vertical-alignment: center; horizontal-stretch: 1; }
            Button { text: @tr("Done"); clicked => { root.close(); } }
        }
        for row[i] in root.rows: Stepper { label: row.label; value: row.value; focused: root.focused-row == i; step(d) => { root.step(i, d); } }
    }
}

export component GameWindow inherits Window {
    default-font-family: Locale.font;
    in property <string> game-title: "RomP";
    in property <string> game-name;
    in property <bool> has-menu;
    in property <bool> menu-open;
    in property <bool> paused;
    in property <int> volume: 100;
    in property <bool> fullscreen;
    in property <bool> sharp: true;
    in property <int> menu-focus: -1;
    in property <bool> mouse-mode;
    in property <bool> mouse-captured;
    in property <bool> lightgun-mode;
    in property <string> menu-key: "Esc";
    in property <string> pause-key: "P";
    in property <string> save-key: "F5";
    in property <string> load-key: "F7";
    in property <string> slot-key: "F6";
    in property <string> guide-name: "Guide";
    in property <string> fullscreen-key: "F11";
    in property <string> screenshot-key: "F12";
    in property <[PortRow]> ports;
    callback cycle-port(int, int);
    callback capture-mouse();
    callback mouse-button(int, bool);
    callback window-active(bool);
    callback resume();
    callback toggle-pause();
    callback restart();
    callback step-volume(int);
    callback toggle-fullscreen();
    callback take-screenshot();
    callback open-controllers();
    callback quit();
    in property <image> frame;
    in property <float> aspect: 4 / 3;
    in property <string> status;
    in property <string> look-label;
    in property <bool> look-open;
    in property <[LookRow]> look-rows;
    in property <int> look-focus;
    callback open-look();
    callback close-look();
    callback step-look(int, int);
    in property <bool> slots-open;
    in property <[SlotCard]> slot-cards;
    in property <int> slots-focus;
    in property <bool> slots-focus-load;
    callback open-slots();
    callback close-slots();
    callback save-slot(int);
    callback load-slot(int);
    in property <bool> hardcore;
    in property <[string]> trackers;
    in property <[image]> challenge-badges;
    in property <string> progress-title;
    in property <string> progress-detail;
    in property <image> progress-badge;
    in property <bool> has-progress-badge;
    in property <bool> has-achievements;
    in property <string> achievements-label;
    in property <bool> achievements-open;
    in property <[AchievementRow]> achievement-rows;
    in-out property <length> achievements-scroll;
    callback open-achievements();
    callback close-achievements();
    in property <string> toast-title;
    in property <string> toast-detail;
    in property <image> toast-badge;
    in property <bool> toast-has-badge;
    in property <string> chip-text;
    in property <int> achievement-corner;
    in property <string> popups-label;
    in property <string> corner-label;
    in property <int> achievements-focus;
    callback step-popups(int);
    callback step-corner(int);
    callback key-event(string, bool, bool, KeyboardModifiers) -> bool;
    callback pointer(float, float, bool);
    callback focus-lost();

    title: root.game-title;
    icon: @image-url("icons/app-icon.png");
    preferred-width: 960px;
    preferred-height: 720px;
    background: black;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            return root.key-event(event.text, true, event.repeat, event.modifiers) ? EventResult.accept : EventResult.reject;
        }
        focus-lost(reason) => {
            root.focus-lost();
            if reason == FocusReason.window-activation {
                root.window-active(false);
            }
        }
        focus-gained(reason) => {
            if reason == FocusReason.window-activation {
                root.window-active(true);
            }
        }
        key-released(event) => {
            return root.key-event(event.text, false, false, event.modifiers) ? EventResult.accept : EventResult.reject;
        }

        frame := Image {
            source: root.frame;
            image-fit: fill;
            image-rendering: root.sharp ? ImageRendering.pixelated : ImageRendering.smooth;
            width: min(parent.width, parent.height * root.aspect);
            height: self.width / root.aspect;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        TouchArea {
            x: frame.x;
            y: frame.y;
            width: frame.width;
            height: frame.height;
            mouse-cursor: root.lightgun-mode ? MouseCursor.crosshair : MouseCursor.default;
            pointer-event(event) => {
                if root.lightgun-mode {
                    root.pointer(self.mouse-x / self.width, self.mouse-y / self.height, false);
                    if event.kind != PointerEventKind.move {
                        root.mouse-button(
                            event.button == PointerEventButton.left ? 1 : event.button == PointerEventButton.right ? 2 : event.button == PointerEventButton.middle ? 4 : 0,
                            event.kind == PointerEventKind.down);
                    }
                    return;
                }
                if root.mouse-mode {
                    if event.kind == PointerEventKind.move {
                        return;
                    }
                    if !root.mouse-captured {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            root.capture-mouse();
                        }
                        return;
                    }
                    root.mouse-button(
                        event.button == PointerEventButton.left ? 1 : event.button == PointerEventButton.right ? 2 : event.button == PointerEventButton.middle ? 4 : 0,
                        event.kind == PointerEventKind.down);
                    return;
                }
                if event.button == PointerEventButton.left && event.kind != PointerEventKind.move {
                    root.pointer(self.mouse-x / self.width, self.mouse-y / self.height, event.kind == PointerEventKind.down);
                }
            }
            moved => {
                if self.pressed && !root.mouse-mode {
                    root.pointer(self.mouse-x / self.width, self.mouse-y / self.height, true);
                }
            }
        }

        if root.paused && !root.menu-open: Rectangle {
            x: (parent.width - self.width) / 2;
            y: 16px;
            width: paused-row.preferred-width;
            height: 34px;
            border-radius: 17px;
            background: Theme.surface-raised.with-alpha(0.92);
            border-width: 1px;
            border-color: Theme.border-subtle;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;
            paused-row := Row {
                padding-left: 14px;
                padding-right: 8px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: Theme.warning; }
                }
                Text { horizontal-alignment: Locale.start; text: @tr("Paused"); vertical-alignment: center; color: Theme.text-strong; font-size: Theme.font-body; font-weight: 600; }
                VerticalLayout {
                    alignment: center;
                    KeyCap { text: root.menu-key == "Esc" ? root.pause-key : root.menu-key; }
                }
            }
        }

        if root.has-menu && root.menu-open && !root.look-open: GameMenu {
            width: parent.width;
            height: parent.height;
            name: root.game-name;
            paused: root.paused;
            volume: root.volume;
            fullscreen: root.fullscreen;
            focused-item: root.menu-focus;
            ports: root.ports;
            menu-key: root.menu-key;
            pause-key: root.pause-key;
            save-key: root.save-key;
            load-key: root.load-key;
            slot-key: root.slot-key;
            guide-name: root.guide-name;
            fullscreen-key: root.fullscreen-key;
            screenshot-key: root.screenshot-key;
            has-achievements: root.has-achievements;
            achievements-label: root.achievements-label;
            hardcore: root.hardcore;
            open-achievements => { root.open-achievements(); }
            open-slots => { root.open-slots(); }
            look-label: root.look-label;
            open-look => { root.open-look(); }
            cycle-port(i, step) => { root.cycle-port(i, step); }
            resume => { root.resume(); }
            toggle-pause => { root.toggle-pause(); }
            restart => { root.restart(); }
            step-volume(d) => { root.step-volume(d); }
            toggle-fullscreen => { root.toggle-fullscreen(); }
            take-screenshot => { root.take-screenshot(); }
            open-controllers => { root.open-controllers(); }
            quit => { root.quit(); }
        }

        if root.look-open: LookPanel {
            width: min(parent.width - 32px, 420px);
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 16px;
            rows: root.look-rows;
            focused-row: root.look-focus;
            step(row, delta) => { root.step-look(row, delta); }
            close => { root.close-look(); }
        }

        if root.slots-open: Rectangle {
            background: Theme.scrim;
            TouchArea { }
            Rectangle {
                width: min(parent.width - 32px, 560px);
                height: min(parent.height - 32px, slots-box.preferred-height);
                background: Theme.surface-raised;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border-subtle;
                clip: true;
                slots-box := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Row {
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text { horizontal-alignment: Locale.start; text: @tr("Save states"); font-size: Theme.font-subtitle; font-weight: 700; color: Theme.text-strong; }
                            Text { horizontal-alignment: Locale.start;
                                text: root.hardcore ? @tr("Hardcore mode: you can save, but not load.") : @tr("Choose Save or Load on a slot.");
                                font-size: Theme.font-small;
                                color: Theme.text-muted;
                            }
                        }
                        Button { text: @tr("Close"); clicked => { root.close-slots(); } }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        SlotTile { card: root.slot-cards[Locale.rtl ? 1 : 0]; focused: root.slots-focus == (Locale.rtl ? 2 : 1); load-focused: root.slots-focus-load; hardcore: root.hardcore; save(slot) => { root.save-slot(slot); } load(slot) => { root.load-slot(slot); } }
                        SlotTile { card: root.slot-cards[Locale.rtl ? 0 : 1]; focused: root.slots-focus == (Locale.rtl ? 1 : 2); load-focused: root.slots-focus-load; hardcore: root.hardcore; save(slot) => { root.save-slot(slot); } load(slot) => { root.load-slot(slot); } }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        SlotTile { card: root.slot-cards[Locale.rtl ? 3 : 2]; focused: root.slots-focus == (Locale.rtl ? 4 : 3); load-focused: root.slots-focus-load; hardcore: root.hardcore; save(slot) => { root.save-slot(slot); } load(slot) => { root.load-slot(slot); } }
                        SlotTile { card: root.slot-cards[Locale.rtl ? 2 : 3]; focused: root.slots-focus == (Locale.rtl ? 3 : 4); load-focused: root.slots-focus-load; hardcore: root.hardcore; save(slot) => { root.save-slot(slot); } load(slot) => { root.load-slot(slot); } }
                    }
                }
            }
        }

        if root.achievements-open: Rectangle {
            background: Theme.scrim;
            TouchArea { }
            Rectangle {
                width: min(parent.width - 32px, 520px);
                height: parent.height - 48px;
                background: Theme.surface-raised;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border-subtle;
                clip: true;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Row {
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text { horizontal-alignment: Locale.start; text: @tr("Achievements"); font-size: Theme.font-subtitle; font-weight: 700; color: Theme.text-strong; }
                            Text { horizontal-alignment: Locale.start; text: root.achievements-label; font-size: Theme.font-small; color: Theme.text-muted; }
                        }
                        Button { text: @tr("Close"); clicked => { root.close-achievements(); } }
                    }
                    Stepper { label: @tr("Popups"); value: root.popups-label; focused: root.achievements-focus == 0; step(d) => { root.step-popups(d); } }
                    Stepper { label: @tr("Corner"); value: root.corner-label; focused: root.achievements-focus == 1; step(d) => { root.step-corner(d); } }
                    ScrollView {
                        vertical-stretch: 1;
                        content-y <=> root.achievements-scroll;
                        VerticalLayout {
                            for item in root.achievement-rows: AchievementItem { entry: item; }
                        }
                    }
                }
            }
        }

        if root.toast-title != "" || root.chip-text != "" || root.trackers.length > 0 || root.challenge-badges.length > 0 || root.progress-title != "": achievement-column := VerticalLayout {
            property <bool> top: root.achievement-corner == 0 || root.achievement-corner == 1;
            property <bool> left: root.achievement-corner == 1 || root.achievement-corner == 3;
            width: min(parent.width - 32px, 380px);
            height: self.preferred-height;
            x: self.left ? 16px : parent.width - self.width - 16px;
            y: self.top ? 16px : parent.height - self.height - (root.status != "" ? 72px : 16px);
            spacing: 6px;
            if achievement-column.top && root.toast-title != "": AchievementToast { title: root.toast-title; detail: root.toast-detail; badge: root.toast-badge; has-badge: root.toast-has-badge; }
            if root.chip-text != "": HorizontalLayout {
                alignment: achievement-column.left ? start : end;
                Rectangle {
                    width: chip-row.preferred-width;
                    height: chip-row.preferred-height;
                    background: Theme.scrim-strong;
                    border-radius: self.height / 2;
                    chip-row := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 6px;
                        Image { source: @image-url("icons/trophy.svg"); width: 14px; height: 14px; colorize: Theme.text-strong; y: (parent.height - self.height) / 2; }
                        Text { horizontal-alignment: Locale.start; text: root.chip-text; max-width: 300px; overflow: elide; color: Theme.text-strong; font-size: Theme.font-small; font-weight: 600; vertical-alignment: center; }
                    }
                }
            }
            if root.progress-title != "": Rectangle {
                height: progress-row.preferred-height;
                background: Theme.scrim-strong;
                border-radius: 8px;
                progress-row := Row {
                    padding: 8px;
                    spacing: 8px;
                    if root.has-progress-badge: Image { source: root.progress-badge; width: 32px; height: 32px; }
                    VerticalLayout {
                        alignment: center;
                        Text { horizontal-alignment: Locale.start; text: root.progress-title; color: Theme.text-strong; font-size: Theme.font-small; font-weight: 600; overflow: elide; }
                        Text { horizontal-alignment: Locale.start; text: root.progress-detail; color: Theme.text-secondary; font-size: Theme.font-small; }
                    }
                }
            }
            if root.challenge-badges.length > 0: Row {
                alignment: achievement-column.left ? start : end;
                spacing: 4px;
                for badge in root.challenge-badges: Image { source: badge; width: 32px; height: 32px; }
            }
            for tracker in root.trackers: Row {
                alignment: achievement-column.left ? start : end;
                Rectangle {
                    width: tracker-text.preferred-width + 16px;
                    height: tracker-text.preferred-height + 8px;
                    background: Theme.scrim-strong;
                    border-radius: 6px;
                    tracker-text := Text { horizontal-alignment: Locale.start; text: tracker; color: Theme.text-strong; font-size: Theme.font-body; font-weight: 600; }
                }
            }
            if !achievement-column.top && root.toast-title != "": AchievementToast { title: root.toast-title; detail: root.toast-detail; badge: root.toast-badge; has-badge: root.toast-has-badge; }
        }

        if root.status != "": Rectangle {
            x: 16px;
            y: parent.height - self.height - 16px;
            width: parent.width - 32px;
            height: label.preferred-height + 16px;
            background: Theme.scrim-strong;
            border-radius: 6px;
            label := Text { horizontal-alignment: Locale.start;
                x: 8px;
                width: parent.width - 16px;
                text: root.status;
                color: Theme.text-strong;
                font-size: Theme.font-body-large;
                wrap: word-wrap;
            }
        }
    }
}
