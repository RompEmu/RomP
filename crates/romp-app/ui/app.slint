import { Theme } from "theme.slint";
import { FocusRing, KeyActivator } from "focus.slint";
import { Button, CheckBox, ComboBox, LineEdit, ListView, ProgressIndicator, ScrollView, Slider, Spinner, Switch } from "std-widgets.slint";

export struct SidebarEntry { header: bool, key: string, name: string, initial: string, count: int, icon: image, has-icon: bool, glyph: string, expanded: bool, can-add: bool, editable: bool }
export struct Membership { key: string, name: string, member: bool }
export struct DeviceRow { key: string, name: string, detail: string, player: int, active: bool }
export struct StorageRow { label: string, size: string }
export struct KeyHint { keys: string, action: string }
export struct RemapRow { name: string, binding: string, waiting: bool }
export struct GameCard { id: int, title: string, platform: string, cover: image, has-cover: bool, downloaded: bool, focused: bool, favorite: bool, aspect: float }
export struct GameRow { cards: [GameCard], shelf: float }
export struct Fact { label: string, value: string }
export struct Shot { image: image, loaded: bool }

export global Brand {
    out property <string> name: "Romp";
    out property <string> website: "https://github.com/RompEmu/RompEmu";
    out property <string> website-label: "github.com/RompEmu/RompEmu";
    out property <string> tagline: @tr("Play your RomM library, each game in its own sandboxed emulator.");
}

component AppTile inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon;
    in property <length> size: 32px;
    width: root.size;
    height: root.size;
    border-radius: root.size * 0.25;
    clip: true;
    background: @linear-gradient(135deg, Theme.accent-hover 0%, Theme.accent-pressed 100%);
    if root.has-icon: Image { source: root.icon; width: parent.width; height: parent.height; }
    if !root.has-icon: Text {
        text: "▶";
        color: Theme.text-strong;
        font-size: root.size * 0.42;
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: touch.pressed ? Theme.pressed : touch.has-hover && root.enabled ? Theme.hover : transparent;
    Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        colorize: root.enabled ? (touch.has-hover ? Theme.text-strong : Theme.text-secondary) : Theme.text-subtle;
    }
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    keys := KeyActivator { enabled: root.enabled; activate => { root.clicked(); } }
    if keys.has-focus: FocusRing { border-radius: root.border-radius; }
    if root.tooltip != "": Tooltip { text: @markdown("\{root.tooltip}"); }
}

component CountPill inherits Rectangle {
    in property <int> count;
    in property <bool> selected;
    height: 18px;
    width: max(24px, count-text.preferred-width + 12px);
    border-radius: 9px;
    background: root.selected ? Theme.accent-soft-strong : Theme.hover;
    count-text := Text {
        text: root.count;
        font-size: Theme.font-caption;
        color: root.selected ? Theme.text-strong : Theme.text-muted;
    }
}

component Connect inherits Rectangle {
    in-out property <string> server-url;
    in property <string> error;
    in property <bool> busy;
    callback connect();

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 420px;
                spacing: 14px;
                Text { text: @tr("Connect to RomM"); font-size: Theme.font-heading; font-weight: 700; }
                Text { text: @tr("Enter the address of your RomM server."); color: Theme.text-muted; }
                url := LineEdit {
                    placeholder-text: "romm.example.com";
                    text <=> root.server-url;
                    enabled: !root.busy;
                    accepted => { root.connect(); }
                }
                if root.error != "": Text { text: root.error; color: Theme.danger; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    if root.busy: Spinner { indeterminate: true; width: 24px; height: 24px; }
                    Button {
                        text: @tr("Continue");
                        primary: true;
                        enabled: !root.busy && root.server-url != "";
                        clicked => { root.connect(); }
                    }
                }
            }
        }
    }
    init => { url.focus(); }
}

component Pairing inherits Rectangle {
    in property <image> qr;
    in property <string> link;
    in property <string> user-code;
    in property <int> seconds-left;
    in property <string> status;
    in property <bool> failed;
    callback copy-link();
    callback open-link();
    callback cancel();
    callback retry();

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 460px;
                spacing: 14px;
                Text { text: @tr("Approve this device"); font-size: Theme.font-heading; font-weight: 700; }
                Text {
                    text: @tr("Scan the code or open the link on a device signed in to RomM, then approve Romp.");
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    Image { source: root.qr; width: 220px; height: 220px; image-rendering: pixelated; }
                }
                HorizontalLayout {
                    alignment: center;
                    Text { text: root.user-code; font-size: Theme.font-display; font-weight: 700; letter-spacing: 4px; }
                }
                Text { text: root.link; horizontal-alignment: center; color: Theme.text-muted; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Button { text: @tr("Copy link"); clicked => { root.copy-link(); } }
                    Button { text: @tr("Open in browser"); clicked => { root.open-link(); } }
                }
                Text {
                    horizontal-alignment: center;
                    color: root.failed ? Theme.danger : Theme.text-muted;
                    text: root.status != "" ? root.status
                        : @tr("Waiting for approval… ({}:{}{})", floor(root.seconds-left / 60), mod(root.seconds-left, 60) < 10 ? "0" : "", mod(root.seconds-left, 60));
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Button { text: @tr("Back"); clicked => { root.cancel(); } }
                    if root.failed: Button { text: @tr("Try again"); primary: true; clicked => { root.retry(); } }
                }
            }
        }
    }
}


component Avatar inherits Rectangle {
    in property <string> initial;
    in property <image> picture;
    in property <bool> has-picture;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    clip: true;
    background: Theme.surface-muted;
    if !root.has-picture: Text {
        text: root.initial;
        color: Theme.accent-text;
        font-size: Theme.font-body;
        font-weight: 700;
    }
    if root.has-picture: Image {
        source: root.picture;
        width: parent.width;
        height: parent.height;
        image-fit: ImageFit.cover;
    }
}

component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <string> initial;
    in property <bool> compact;
    in property <int> count;
    in property <bool> selected;
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> glyph;
    callback clicked();
    height: 34px;
    border-radius: 8px;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.label;
    accessible-description: root.count >= 0 ? @tr("{n} game" | "{n} games" % root.count) : "";
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea { clicked => { root.clicked(); } }
    keys := KeyActivator { activate => { root.clicked(); } }
    if keys.has-focus: FocusRing { border-radius: root.border-radius; }
    if root.compact: Rectangle {
        if root.has-icon: Image { source: root.icon; width: 18px; height: 18px; image-fit: contain; }
        if !root.has-icon && root.glyph != "": Text { text: root.glyph; color: Theme.favorite; font-size: Theme.font-body; }
        if !root.has-icon && root.glyph == "": Text {
            text: root.initial;
            font-size: Theme.font-body;
            font-weight: 700;
            color: root.selected ? Theme.text-strong : Theme.text-secondary;
        }
    }
    if root.compact: Tooltip { text: @markdown("\{root.label}"); }
    if !root.compact: HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle {
            width: 18px;
            if root.has-icon: Image { source: root.icon; width: 18px; height: 18px; image-fit: contain; }
            if !root.has-icon: Text { text: root.glyph; color: Theme.favorite; font-size: Theme.font-body; }
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            font-size: Theme.font-body;
            font-weight: root.selected ? 600 : 400;
            color: root.selected ? Theme.text-strong : Theme.text-secondary;
        }
        if root.count >= 0: VerticalLayout {
            alignment: center;
            CountPill { count: root.count; selected: root.selected; }
        }
    }
}

component SectionHeader inherits Rectangle {
    in property <string> label;
    in property <bool> expanded;
    in property <bool> can-add;
    callback toggled();
    callback add();
    height: 32px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-default => { root.toggled(); }
    accessible-action-expand => { root.toggled(); }
    touch := TouchArea { clicked => { root.toggled(); } }
    keys := KeyActivator { activate => { root.toggled(); } }
    if keys.has-focus: FocusRing { border-radius: 6px; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        padding-top: 8px;
        spacing: 6px;
        Rectangle {
            width: 10px;
            Path {
                width: 6px;
                height: 6px;
                commands: root.expanded ? "M 0 2 L 8 2 L 4 7 Z" : "M 2 0 L 7 4 L 2 8 Z";
                fill: Theme.text-subtle;
            }
        }
        Text {
            text: root.label;
            font-size: Theme.font-caption;
            font-weight: 700;
            letter-spacing: 1px;
            color: touch.has-hover ? Theme.text-secondary : Theme.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.can-add: Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 4px;
            background: add-touch.has-hover ? Theme.surface-muted : transparent;
            Text { text: "+"; font-size: Theme.font-subtitle; color: Theme.text-secondary; }
            accessible-role: button;
            accessible-label: @tr("New collection");
            accessible-action-default => { root.add(); }
            add-touch := TouchArea { clicked => { root.add(); } }
            add-keys := KeyActivator { activate => { root.add(); } }
            if add-keys.has-focus: FocusRing { border-radius: parent.border-radius; }
            Tooltip { text: @markdown("\{@tr("New collection")}"); }
        }
    }
}

component Card inherits Rectangle {
    in property <GameCard> game;
    in property <length> shelf: 230px;
    callback clicked();
    width: 172px;
    height: root.shelf + 60px;
    accessible-role: button;
    accessible-label: root.game.title;
    accessible-description: root.game.platform + (root.game.downloaded ? ", " + @tr("downloaded") : "") + (root.game.favorite ? ", " + @tr("favorite") : "");
    accessible-action-default => { root.clicked(); }
    touch := TouchArea { clicked => { root.clicked(); } }
    keys := KeyActivator { activate => { root.clicked(); } }
    VerticalLayout {
        alignment: start;
        spacing: 6px;
        Rectangle {
            height: root.shelf;
            property <float> aspect: root.game.aspect > 0 ? root.game.aspect : 0.71;
            property <length> box-width: min(self.width, 230px * self.aspect);
            Rectangle {
                width: parent.box-width;
                height: parent.box-width / parent.aspect;
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height;
                border-radius: 8px;
                clip: true;
                background: Theme.surface-muted;
                if root.game.has-cover: Image {
                    source: root.game.cover;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                }
                if !root.game.has-cover: Text {
                    text: root.game.title;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width - 16px;
                    x: 8px;
                }
                if root.game.favorite: Rectangle {
                    x: 8px;
                    y: 8px;
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: Theme.scrim;
                    Text { text: "♥"; color: Theme.favorite; font-size: Theme.font-body; }
                }
                if root.game.downloaded: Rectangle {
                    x: parent.width - self.width - 8px;
                    y: 8px;
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: Theme.success;
                    Text { text: "✓"; color: Theme.text-strong; font-weight: 700; }
                }
                if touch.has-hover: Rectangle { background: Theme.hover; }
                if root.game.focused || keys.has-focus: Rectangle {
                    border-radius: 8px;
                    border-width: 3px;
                    border-color: Theme.accent;
                }
            }
        }
        Text { text: root.game.title; overflow: elide; font-weight: 600; }
        HorizontalLayout {
            spacing: 4px;
            Text { text: root.game.platform; overflow: elide; color: Theme.text-muted; font-size: Theme.font-small; horizontal-stretch: 1; }
            Text {
                text: root.game.downloaded ? @tr("Downloaded") : @tr("On server");
                color: root.game.downloaded ? Theme.success : Theme.text-muted;
                font-size: Theme.font-small;
                font-weight: root.game.downloaded ? 600 : 400;
            }
        }
    }
}

component Library inherits Rectangle {
    in property <string> user-label;
    in property <string> server-label;
    in property <string> heading;
    in property <string> heading-detail;
    in property <image> app-icon;
    in property <bool> has-app-icon;
    callback open-about();
    in property <bool> page-open;
    public function focus-search() { search-field.focus(); }
    in property <bool> compact;
    in property <image> user-avatar;
    in property <bool> has-user-avatar;
    in property <string> user-initial;
    in property <[SidebarEntry]> sidebar;
    in property <string> selected-key;
    in property <[GameRow]> rows;
    in property <string> sync-status;
    in property <bool> syncing;
    in-out property <string> search;
    callback select(string);
    callback toggle-section(string);
    callback new-collection();
    callback rename-collection(string);
    callback delete-collection(string);
    callback search-edited(string);
    callback columns-changed(int);
    callback row-shown(int);
    callback refresh();
    callback open-settings();
    callback open-game(int);
    in property <bool> needs-pairing;
    in property <string> pair-prompt;
    callback pair-again();
    in-out property <bool> downloaded-only;
    in property <bool> offline;
    in-out property <int> sort-index;
    callback sort-changed(int);
    callback downloaded-only-toggled(bool);
    in property <int> focus-row: -1;
    in-out property <length> scroll-y <=> games.content-y;
    in property <length> focus-top;
    in property <length> focus-bottom;
    background: Theme.background;
    changed focus-row => {
        if root.focus-row >= 0 {
            if root.focus-top < -games.content-y {
                games.content-y = -root.focus-top;
            }
            if root.focus-bottom > -games.content-y + games.visible-height {
                games.content-y = -(root.focus-bottom - games.visible-height);
            }
        }
    }

    HorizontalLayout {
        Rectangle {
            width: root.compact ? 64px : 248px;
            animate width { duration: 150ms; easing: ease-out; }
            background: Theme.sidebar;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.divider;
            }
            VerticalLayout {
                padding-top: 16px;
                padding-bottom: 12px;
                padding-left: root.compact ? 8px : 12px;
                padding-right: root.compact ? 8px : 12px;
                spacing: 6px;
                HorizontalLayout {
                    padding-left: root.compact ? 0 : 4px;
                    padding-bottom: 10px;
                    spacing: 10px;
                    alignment: root.compact ? center : stretch;
                    AppTile {
                        icon: root.app-icon;
                        has-icon: root.has-app-icon;
                        if root.compact: Tooltip { text: @markdown("\{Brand.name} · \{root.offline ? @tr("Offline") : root.server-label}"); }
                    }
                    if !root.compact: VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: Brand.name; font-size: Theme.font-subtitle; font-weight: 700; color: Theme.text-strong; }
                        HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 7px;
                                    height: 7px;
                                    border-radius: 3.5px;
                                    background: root.offline ? Theme.warning : root.syncing ? Theme.accent : Theme.success;
                                }
                            }
                            Text {
                                text: root.offline ? @tr("Offline") : root.syncing ? @tr("Syncing…") : root.server-label;
                                font-size: Theme.font-caption;
                                color: Theme.text-muted;
                                overflow: elide;
                            }
                        }
                    }
                }
                ListView {

                    vertical-stretch: 1;
                    for e in root.sidebar: HorizontalLayout {
                        padding-right: root.compact ? 0 : 14px;
                        if e.header && root.compact: VerticalLayout {
                            height: 17px;
                            alignment: center;
                            padding-left: 8px;
                            padding-right: 8px;
                            Rectangle { height: 1px; background: Theme.divider; }
                        }
                        if e.header && !root.compact: SectionHeader {
                            label: e.name;
                            expanded: e.expanded;
                            can-add: e.can-add;
                            toggled => { root.toggle-section(e.key); }
                            add => { root.new-collection(); }
                        }
                        if !e.header && e.editable: ContextMenuArea {
                            height: 34px;
                            Menu {
                                MenuItem { title: @tr("Rename…"); activated => { root.rename-collection(e.key); } }
                                MenuItem { title: @tr("Delete…"); activated => { root.delete-collection(e.key); } }
                            }
                            SidebarItem {
                                width: parent.width;
                                compact: root.compact;
                                initial: e.initial;
                                label: e.name;
                                count: e.count;
                                icon: e.icon;
                                has-icon: e.has-icon;
                                glyph: e.glyph;
                                selected: root.selected-key == e.key;
                                clicked => { root.select(e.key); }
                            }
                        }
                        if !e.header && !e.editable: SidebarItem {
                            compact: root.compact;
                            initial: e.initial;
                            label: e.name;
                            count: e.count;
                            icon: e.icon;
                            has-icon: e.has-icon;
                            glyph: e.glyph;
                            selected: root.selected-key == e.key;
                            clicked => { root.select(e.key); }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }
                if root.compact: VerticalLayout {
                    padding-top: 6px;
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: center;
                        Avatar {
                            initial: root.user-initial;
                            picture: root.user-avatar;
                            has-picture: root.has-user-avatar;
                            Tooltip { text: @markdown("\{root.user-label != "" ? root.user-label : @tr("Signed in")}"); }
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        IconButton { icon: @image-url("icons/info.svg"); tooltip: @tr("About"); clicked => { root.open-about(); } }
                    }
                    HorizontalLayout {
                        alignment: center;
                        IconButton { icon: @image-url("icons/settings.svg"); tooltip: @tr("Settings"); clicked => { root.open-settings(); } }
                    }
                }
                if !root.compact: HorizontalLayout {
                    padding-top: 6px;
                    padding-left: 4px;
                    spacing: 10px;
                    Avatar {
                        initial: root.user-initial;
                        picture: root.user-avatar;
                        has-picture: root.has-user-avatar;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.user-label != "" ? root.user-label : @tr("Signed in");
                            font-size: Theme.font-body;
                            font-weight: 600;
                            color: Theme.text;
                            overflow: elide;
                        }
                    }
                    IconButton { icon: @image-url("icons/info.svg"); tooltip: @tr("About"); clicked => { root.open-about(); } }
                    IconButton { icon: @image-url("icons/settings.svg"); tooltip: @tr("Settings"); clicked => { root.open-settings(); } }
                }

            }
        }
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                visible: !root.page-open;
                VerticalLayout {
                    padding-top: 18px;
                    padding-left: 20px;
                    padding-right: 16px;
                    padding-bottom: 8px;
                    spacing: 12px;
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text { text: root.heading; font-size: Theme.font-heading; font-weight: 800; color: Theme.text-strong; overflow: elide; }
                            Text {
                                text: root.sync-status != "" ? root.heading-detail + "  ·  " + root.sync-status : root.heading-detail;
                                font-size: Theme.font-small;
                                color: Theme.text-muted;
                                overflow: elide;
                            }
                        }
                        if root.needs-pairing: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 30px;
                                width: pair-text.preferred-width + 24px;
                                border-radius: 15px;
                                background: pair-touch.has-hover ? Theme.accent-soft-strong : Theme.accent-soft;
                                pair-text := Text { text: root.pair-prompt; font-size: Theme.font-small; font-weight: 600; color: Theme.accent-text; }
                                accessible-role: button;
                                accessible-label: root.pair-prompt;
                                accessible-action-default => { root.pair-again(); }
                                pair-touch := TouchArea { clicked => { root.pair-again(); } }
                                pair-keys := KeyActivator { activate => { root.pair-again(); } }
                                if pair-keys.has-focus: FocusRing { border-radius: parent.border-radius; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            search-field := LineEdit {
                                width: 240px;
                                placeholder-text: @tr("Search games");
                                text <=> root.search;
                                edited(text) => { root.search-edited(text); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            ComboBox {
                                width: 140px;
                                model: [@tr("Name"), @tr("Date added"), @tr("Last played")];
                                current-index <=> root.sort-index;
                                enabled: root.selected-key != "recent";
                                selected => { root.sort-changed(self.current-index); }
                            }
                        }
                        Switch {
                            text: @tr("Downloaded");
                            checked <=> root.downloaded-only;
                            enabled: !root.offline;
                            toggled => { root.downloaded-only-toggled(self.checked); }
                        }
                        VerticalLayout {
                            alignment: center;
                            if root.syncing: Spinner { indeterminate: true; width: 20px; height: 20px; }
                            if !root.syncing: IconButton { icon: @image-url("icons/refresh.svg"); tooltip: @tr("Refresh library"); clicked => { root.refresh(); } }
                        }
                    }
                    grid := Rectangle {
                        vertical-stretch: 1;
                        property <int> columns: max(1, floor((self.width - 24px) / 188px));
                        changed columns => { root.columns-changed(self.columns); }
                        init => { root.columns-changed(self.columns); }
                        if root.rows.length == 0: Text {
                            text: root.syncing ? @tr("Loading your library…") : @tr("No games found.");
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        games := ListView {
                            for row[i] in root.rows: HorizontalLayout {
                                property <int> index: i;
                                padding: 8px;
                                spacing: 16px;
                                alignment: start;
                                init => { root.row-shown(i); }
                                changed index => { root.row-shown(self.index); }
                                for game in row.cards: Card {
                                    game: game;
                                    shelf: row.shelf * 1px;
                                    clicked => { root.open-game(game.id); }
                                }
                            }
                        }
                    }
                }
            }
            @children
        }
    }
}


component SectionTitle inherits Text {
    font-size: Theme.font-title;
    font-weight: 700;
    color: Theme.text;
}

component Breadcrumb inherits Rectangle {
    in property <string> back-label;
    in property <string> current;
    callback back();
    vertical-stretch: 0;
    height: row.preferred-height;
    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: 20px;
        padding-top: 14px;
        padding-bottom: 10px;
        spacing: 4px;
        IconButton { icon: @image-url("icons/back.svg"); tooltip: @tr("Back"); clicked => { root.back(); } }
        Rectangle {
            width: crumb-text.preferred-width + 16px;
            height: 32px;
            border-radius: 6px;
            background: crumb-touch.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: root.back-label;
            accessible-action-default => { root.back(); }
            crumb-text := Text {
                text: root.back-label;
                font-size: Theme.font-body;
                color: crumb-touch.has-hover ? Theme.text-strong : Theme.text-secondary;
            }
            crumb-touch := TouchArea { mouse-cursor: pointer; clicked => { root.back(); } }
            crumb-keys := KeyActivator { activate => { root.back(); } }
            if crumb-keys.has-focus: FocusRing { border-radius: parent.border-radius; }
        }
        Text { text: "›"; font-size: Theme.font-subtitle; color: Theme.text-subtle; vertical-alignment: center; }
        Text {
            text: root.current;
            font-size: Theme.font-body;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 40px;
        }
    }
}

component GamePage inherits FocusScope {
    in property <string> back-label;
    in property <string> title;
    in property <string> category;
    in property <string> subtitle;
    in property <string> summary;
    in property <[Fact]> facts;
    in property <[Shot]> shots;
    in property <[GameCard]> similar;
    in property <float> similar-shelf: 230;
    in property <image> cover;
    in property <float> cover-aspect: 0.71;
    in property <bool> has-cover;
    in property <bool> downloaded;
    in property <bool> busy;
    in property <bool> playable;
    in property <bool> can-download;
    in property <float> progress;
    in property <string> status;
    in property <bool> conflict;
    in property <string> conflict-text;
    callback keep-local();
    callback keep-server();
    callback back();
    callback download();
    callback cancel();
    callback play();
    callback delete();
    callback open-game(int);
    in property <bool> show-collections;
    in property <bool> can-edit-collections;
    in property <bool> favorite;
    in property <[Membership]> memberships;
    callback toggle-favorite();
    callback toggle-membership(string, bool);
    callback new-collection();

    property <int> viewing: -1;
    property <bool> banner-from-shot: root.shots.length > 0 && root.shots[0].loaded;
    property <bool> has-banner: root.banner-from-shot || root.has-cover;
    changed title => { self.viewing = -1; page.content-y = 0; }
    init => { self.focus(); }
    key-pressed(event) => {
        if event.text == Key.Escape {
            if root.viewing >= 0 {
                root.viewing = -1;
            } else {
                root.back();
            }
            return accept;
        }
        if root.viewing >= 0 && event.text == Key.LeftArrow && root.viewing > 0 {
            root.viewing -= 1;
            return accept;
        }
        if root.viewing >= 0 && event.text == Key.RightArrow && root.viewing < root.shots.length - 1 {
            root.viewing += 1;
            return accept;
        }
        return reject;
    }

    VerticalLayout {
        Breadcrumb {
            back-label: root.back-label;
            current: root.title;
            back => { root.back(); }
        }
        page := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: body.preferred-height;
            if root.has-banner: Rectangle {
                x: 0;
                y: 0;
                width: page.visible-width;
                height: 280px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.banner-from-shot ? root.shots[0].image : root.cover;
                    image-fit: ImageFit.cover;
                    opacity: root.banner-from-shot ? 0.55 : 0.3;
                }
                Rectangle {
                    background: @linear-gradient(180deg, Theme.background.with-alpha(0.2) 0%, Theme.background 100%);
                }
            }
            body := VerticalLayout {
                width: page.visible-width;
                padding-left: 24px;
                padding-right: 24px;
                padding-top: root.has-banner ? 120px : 8px;
                padding-bottom: 32px;
                spacing: 32px;
                HorizontalLayout {
                    spacing: 28px;
                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: min(260px, 347px * root.cover-aspect);
                            height: self.width / root.cover-aspect;
                            border-radius: 10px;
                            clip: true;
                            background: Theme.surface-muted;
                            if root.has-cover: Image { source: root.cover; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: start;
                        spacing: 10px;
                        if root.category != "": Text {
                            text: root.category;
                            font-size: Theme.font-caption;
                            font-weight: 700;
                            letter-spacing: 1.5px;
                            color: Theme.accent;
                        }
                        Text { text: root.title; font-size: Theme.font-display; font-weight: 800; wrap: word-wrap; }
                        Text { text: root.subtitle; font-size: Theme.font-subtitle; color: Theme.text-muted; wrap: word-wrap; }
                        HorizontalLayout {
                            padding-top: 8px;
                            alignment: start;
                            spacing: 10px;
                            if !root.downloaded && !root.busy && root.playable: Button {
                                text: @tr("Download");
                                primary: true;
                                enabled: root.can-download;
                                clicked => { root.download(); }
                            }
                            if root.busy: ProgressIndicator { width: 220px; progress: root.progress; }
                            if root.busy: Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
                            if root.downloaded && !root.busy: Button { text: @tr("Play"); primary: true; clicked => { root.play(); } }
                            if root.downloaded && !root.busy: Button { text: @tr("Delete download"); clicked => { root.delete(); } }
                            if root.show-collections: Button {
                                text: root.favorite ? @tr("♥ In favorites") : @tr("♡ Add to favorites");
                                enabled: root.can-edit-collections;
                                clicked => { root.toggle-favorite(); }
                            }
                            if root.show-collections: Rectangle {
                                width: collections-button.preferred-width;
                                collections-button := Button {
                                    width: parent.width;
                                    height: parent.height;
                                    text: @tr("Collections…");
                                    enabled: root.can-edit-collections;
                                    clicked => { collections-popup.show(); }
                                }
                                collections-popup := PopupWindow {
                                    y: parent.height + 4px;
                                    width: 260px;
                                    height: popup-list.preferred-height;
                                    close-policy: close-on-click-outside;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        background: Theme.surface-raised;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: Theme.surface-selected;
                                        drop-shadow-blur: 12px;
                                        drop-shadow-color: Theme.shadow;
                                        popup-list := VerticalLayout {
                                            width: parent.width;
                                            padding: 12px;
                                            spacing: 6px;
                                            if root.memberships.length == 0: Text {
                                                text: @tr("You don't have any collections yet.");
                                                color: Theme.text-muted;
                                                wrap: word-wrap;
                                            }
                                            for m in root.memberships: CheckBox {
                                                text: m.name;
                                                checked: m.member;
                                                toggled => { root.toggle-membership(m.key, self.checked); }
                                            }
                                            Button {
                                                text: @tr("New collection…");
                                                clicked => {
                                                    collections-popup.close();
                                                    root.new-collection();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.status != "": Text { text: root.status; color: Theme.text-secondary; wrap: word-wrap; }
                        if root.conflict: Rectangle {
                            border-radius: 8px;
                            background: Theme.warning-surface;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: @tr("Your save changed on this computer and on the server."); font-weight: 700; wrap: word-wrap; }
                                Text { text: root.conflict-text; color: Theme.text-secondary; wrap: word-wrap; }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 10px;
                                    Button { text: @tr("Use this computer's save"); clicked => { root.keep-local(); } }
                                    Button { text: @tr("Use the server's save"); clicked => { root.keep-server(); } }
                                }
                            }
                        }
                        VerticalLayout {
                            padding-top: 16px;
                            spacing: 11px;
                            for fact in root.facts: HorizontalLayout {
                                spacing: 18px;
                                Text { text: fact.label; width: 110px; font-size: Theme.font-body-large; color: Theme.text-muted; line-height-factor: 1.3; }
                                Text { text: fact.value; font-size: Theme.font-body-large; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; line-height-factor: 1.3; }
                            }
                        }
                    }
                }
                if root.summary != "": VerticalLayout {
                    spacing: 12px;
                    SectionTitle { text: @tr("Overview"); }
                    HorizontalLayout {
                        alignment: start;
                        Text {
                            text: root.summary;
                            max-width: 720px;
                            wrap: word-wrap;
                            font-size: Theme.font-subtitle;
                            line-height-factor: 1.55;
                            color: Theme.text-secondary;
                        }
                    }
                }
                if root.shots.length > 0: VerticalLayout {
                    spacing: 10px;
                    SectionTitle { text: @tr("Screenshots"); }
                    shots-view := ScrollView {
                        height: 214px;
                        content-width: shot-row.preferred-width;
                        content-height: self.visible-height;
                        shot-row := HorizontalLayout {
                            spacing: 12px;
                            padding-bottom: 14px;
                            for shot[i] in root.shots: Rectangle {
                                width: 266px;
                                height: 200px;
                                border-radius: 8px;
                                clip: true;
                                background: Theme.surface-muted;
                                if shot.loaded: Image { source: shot.image; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
                                accessible-role: button;
                                accessible-label: @tr("Screenshot {}", i + 1);
                                accessible-action-default => { root.viewing = i; }
                                shot-touch := TouchArea { clicked => { root.viewing = i; } }
                                shot-keys := KeyActivator { activate => { root.viewing = i; } }
                                if shot-touch.has-hover: Rectangle { background: Theme.hover; }
                                if shot-keys.has-focus: FocusRing { border-radius: parent.border-radius; }
                            }
                        }
                    }
                }
                if root.similar.length > 0: VerticalLayout {
                    spacing: 10px;
                    SectionTitle { text: @tr("Similar in your library"); }
                    ScrollView {
                        height: root.similar-shelf * 1px + 74px;
                        content-width: similar-row.preferred-width;
                        content-height: self.visible-height;
                        similar-row := HorizontalLayout {
                            spacing: 16px;
                            padding-bottom: 14px;
                            for game in root.similar: Card {
                                game: game;
                                shelf: root.similar-shelf * 1px;
                                clicked => { root.open-game(game.id); }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.viewing >= 0 && root.viewing < root.shots.length: Rectangle {
        background: Theme.scrim-strong;
        TouchArea { clicked => { root.viewing = -1; } }
        Image {
            x: 72px;
            y: 48px;
            width: parent.width - 144px;
            height: parent.height - 96px;
            source: root.shots[root.viewing].image;
            image-fit: contain;
        }
        if root.viewing > 0: Button {
            x: 16px;
            y: (parent.height - self.height) / 2;
            text: "‹";
            clicked => { root.viewing -= 1; }
        }
        if root.viewing < root.shots.length - 1: Button {
            x: parent.width - self.width - 16px;
            y: (parent.height - self.height) / 2;
            text: "›";
            clicked => { root.viewing += 1; }
        }
        Button {
            x: parent.width - self.width - 16px;
            y: 12px;
            text: @tr("Close");
            clicked => { root.viewing = -1; }
        }
    }
}

component Panel inherits Rectangle {
    clip: true;
    background: Theme.surface-raised;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.surface-muted;
    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        @children
    }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> divider;
    in property <bool> highlight;
    in property <color> detail-color: Theme.text-muted;
    background: root.highlight ? Theme.accent-soft-strong : transparent;
    animate background { duration: 150ms; }
    VerticalLayout {
        if root.divider: Rectangle { height: 1px; background: Theme.surface-muted; }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text { text: root.label; font-size: Theme.font-body-large; overflow: elide; }
                if root.detail != "": Text { text: root.detail; font-size: Theme.font-small; color: root.detail-color; wrap: word-wrap; }
            }
            @children
        }
    }
}

component SectionHeading inherits VerticalLayout {
    in property <string> subtitle;
    padding-bottom: 4px;
    Text { text: root.subtitle; font-size: Theme.font-body-large; color: Theme.text-secondary; wrap: word-wrap; }
}

component SettingsTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    width: tab-text.preferred-width + 24px;
    height: 36px;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea { clicked => { root.clicked(); } }
    keys := KeyActivator { activate => { root.clicked(); } }
    if keys.has-focus: FocusRing { border-radius: Theme.radius-small; }
    tab-text := Text {
        text: root.label;
        font-size: Theme.font-body-large;
        font-weight: root.selected ? 600 : 500;
        color: root.selected ? Theme.text-strong : touch.has-hover ? Theme.text : Theme.text-muted;
    }
    Rectangle {
        y: parent.height - self.height;
        x: 12px;
        width: parent.width - 24px;
        height: 2px;
        border-radius: 1px;
        background: root.selected ? Theme.accent : transparent;
    }
}

component SettingsPage inherits FocusScope {
    in property <string> back-label;
    in property <bool> remap-open;
    in-out property <int> section;
    in property <string> user;
    in property <string> server;
    in property <bool> offline;
    in property <[DeviceRow]> devices;
    in property <[KeyHint]> keys;
    in property <[StorageRow]> storage;
    in property <string> storage-total;
    in property <bool> storage-busy;
    in-out property <bool> pause-unfocused;
    in-out property <bool> resume;
    in-out property <bool> fullscreen;
    in-out property <bool> sharp;
    in-out property <float> volume;
    in-out property <int> ui-scale;
    callback prefs-changed();
    in-out property <bool> nintendo-labels;
    in-out property <bool> stick-dpad;
    callback controller-options-changed();
    callback customize(string);
    callback back();
    callback sign-out();
    callback pair-again();
    callback assign(string, int);
    callback clear-images();
    callback show-folder();
    callback section-changed(int);

    init => { self.focus(); }
    key-pressed(event) => {
        if event.text == Key.Escape && !root.remap-open {
            root.back();
            return accept;
        }
        return reject;
    }

    VerticalLayout {
        Breadcrumb {
            back-label: root.back-label;
            current: @tr("Settings");
            back => { root.back(); }
        }
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 10px;
            Text { text: @tr("Settings"); font-size: Theme.font-heading; font-weight: 800; color: Theme.text-strong; }
            HorizontalLayout {
                alignment: start;
                for label[i] in [@tr("General"), @tr("Account"), @tr("Players"), @tr("Storage")]: SettingsTab {
                    label: label;
                    selected: root.section == i;
                    clicked => { root.section = i; root.section-changed(i); }
                }
            }
            Rectangle { height: 1px; background: Theme.divider; }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            content := ScrollView {
                horizontal-stretch: 1;
                content-width: self.visible-width;
                content-height: body.preferred-height;
                body := VerticalLayout {
                    x: 0;
                    width: min(content.visible-width, 760px);
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 20px;
                    padding-bottom: 32px;
                    spacing: 16px;
                    if root.section == 0: VerticalLayout {
                        spacing: 16px;
                        SectionHeading { subtitle: @tr("How games behave on this computer."); }
                        Panel {
                            SettingRow {
                                label: @tr("Pause when the game window isn't focused");
                                detail: @tr("Switching to another window pauses the game. Coming back resumes it.");
                                Switch { checked <=> root.pause-unfocused; toggled => { root.prefs-changed(); } }
                            }
                            SettingRow {
                                divider: true;
                                label: @tr("Resume where you left off");
                                detail: @tr("Starting a game continues from the automatic save made when you last quit it.");
                                Switch { checked <=> root.resume; toggled => { root.prefs-changed(); } }
                            }
                            SettingRow {
                                divider: true;
                                label: @tr("Start games in full screen");
                                detail: @tr("Press F11 in a game to switch at any time.");
                                Switch { checked <=> root.fullscreen; toggled => { root.prefs-changed(); } }
                            }
                            SettingRow {
                                divider: true;
                                label: @tr("Sharp pixels");
                                detail: @tr("Keeps pixel art crisp. Turn off for smoother scaling.");
                                Switch { checked <=> root.sharp; toggled => { root.prefs-changed(); } }
                            }
                            SettingRow {
                                divider: true;
                                label: @tr("Game volume");
                                detail: round(root.volume) + "%";
                                Slider {
                                    width: 200px;
                                    minimum: 0;
                                    maximum: 100;
                                    value <=> root.volume;
                                    changed => { root.prefs-changed(); }
                                }
                            }
                            SettingRow {
                                divider: true;
                                label: @tr("Interface size");
                                detail: @tr("Makes text and controls in this window larger.");
                                ComboBox {
                                    width: 120px;
                                    model: ["1×", "1.5×", "2×"];
                                    current-index <=> root.ui-scale;
                                    selected => { root.prefs-changed(); }
                                }
                            }
                        }
                    }
                    if root.section == 1: VerticalLayout {
                        spacing: 16px;
                        SectionHeading { subtitle: @tr("Your RomM server and this device's access to it."); }
                        Panel {
                            SettingRow { label: @tr("Signed in as"); detail: root.user != "" ? root.user : @tr("Unknown"); }
                            SettingRow {
                                divider: true;
                                label: @tr("Server");
                                detail: root.server + (root.offline ? "  ·  " + @tr("Offline") : "");
                            }
                            SettingRow {
                                divider: true;
                                label: @tr("Device access");
                                detail: @tr("Approve this device again, for example after an update that needs new permissions.");
                                Button { text: @tr("Pair again"); enabled: !root.offline; clicked => { root.pair-again(); } }
                            }
                            SettingRow {
                                divider: true;
                                label: @tr("Sign out");
                                detail: @tr("Signs this device out and clears the library list. Downloaded files stay on disk.");
                                Button { text: @tr("Sign out"); clicked => { root.sign-out(); } }
                            }
                        }
                    }
                    if root.section == 2: VerticalLayout {
                        spacing: 16px;
                        SectionHeading {
                            subtitle: @tr("Choose which player each controller plays as. Press a button on a controller to find it here.");
                        }
                        Panel {
                            for device[i] in root.devices: SettingRow {
                                divider: i > 0;
                                label: device.name;
                                detail: device.active ? @tr("Button pressed") : device.detail;
                                detail-color: device.active ? Theme.accent : Theme.text-muted;
                                highlight: device.active;
                                Button { text: @tr("Customize…"); clicked => { root.customize(device.key); } }
                                ComboBox {
                                    width: 150px;
                                    model: [@tr("Off"), @tr("Player {}", 1), @tr("Player {}", 2), @tr("Player {}", 3), @tr("Player {}", 4)];
                                    current-index: device.player;
                                    selected => { root.assign(device.key, self.current-index); }
                                }
                            }
                        }
                        Text { text: @tr("Controller options"); font-size: Theme.font-body-large; font-weight: 700; }
                        Panel {
                            SettingRow {
                                label: @tr("Match button labels on Nintendo systems");
                                detail: @tr("On other controllers, the button labelled A presses A instead of the one in its place on a Nintendo pad.");
                                Switch { checked <=> root.nintendo-labels; toggled => { root.controller-options-changed(); } }
                            }
                            SettingRow {
                                divider: true;
                                label: @tr("Left stick also moves the D-pad");
                                detail: @tr("Handy for games made for a D-pad.");
                                Switch { checked <=> root.stick-dpad; toggled => { root.controller-options-changed(); } }
                            }
                        }
                        Text { text: @tr("Shortcuts"); font-size: Theme.font-body-large; font-weight: 700; }
                        Panel {
                            for hint[i] in root.keys: SettingRow {
                                divider: i > 0;
                                label: hint.action;
                                Rectangle {
                                    width: key-text.preferred-width + 16px;
                                    height: 24px;
                                    border-radius: 5px;
                                    background: Theme.surface-muted;
                                    key-text := Text { text: hint.keys; font-size: Theme.font-small; color: Theme.text-secondary; }
                                }
                            }
                        }
                    }
                    if root.section == 3: VerticalLayout {
                        spacing: 16px;
                        SectionHeading {
                            subtitle: root.storage-busy ? @tr("Measuring…") : @tr("Space used on this computer: {}.", root.storage-total);
                        }
                        Panel {
                            for row[i] in root.storage: SettingRow {
                                divider: i > 0;
                                label: row.label;
                                Text { text: row.size; color: Theme.text-secondary; vertical-alignment: center; }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 10px;
                            Button { text: @tr("Clear image cache"); clicked => { root.clear-images(); } }
                            Button { text: @tr("Show folder"); clicked => { root.show-folder(); } }
                        }
                    }
                }
            }
        }
    }
}

component RemapDialog inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <bool> waiting;
    in property <[RemapRow]> rows;
    callback pick(int);
    callback key(string);
    callback reset();
    callback close();
    background: Theme.scrim;
    TouchArea { }
    Rectangle {
        width: 480px;
        height: min(parent.height - 64px, remap-box.preferred-height);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface-raised;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.surface-selected;
        clip: true;
        remap-keys := FocusScope {
            key-pressed(event) => {
                if root.waiting {
                    root.key(event.text);
                    return accept;
                }
                return reject;
            }
            remap-box := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: root.title; font-size: Theme.font-subtitle; font-weight: 700; }
                Text { text: root.hint; color: Theme.text-secondary; wrap: word-wrap; }
                ScrollView {
                    vertical-stretch: 1;
                    min-height: 200px;
                    preferred-height: remap-list.preferred-height;
                    content-width: self.visible-width;
                    content-height: remap-list.preferred-height;
                    remap-list := VerticalLayout {
                        width: parent.width;
                        for row[i] in root.rows: SettingRow {
                            divider: i > 0;
                            label: row.name;
                            highlight: row.waiting;
                            Button {
                                width: 190px;
                                text: row.waiting ? @tr("Press…") : row.binding;
                                clicked => {
                                    root.pick(i);
                                    remap-keys.focus();
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Button { text: @tr("Reset to default"); clicked => { root.reset(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Done"); primary: true; clicked => { root.close(); } }
                }
            }
        }
    }
}

component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <bool> asks-name;
    in-out property <string> value;
    in property <string> confirm-label;
    in property <bool> destructive;
    callback accepted(string);
    callback cancelled();
    background: Theme.scrim;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }
        Rectangle {
            width: 380px;
            height: box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface-raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.surface-selected;
            box := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: root.title; font-size: Theme.font-subtitle; font-weight: 700; }
                if root.message != "": Text { text: root.message; color: Theme.text-secondary; wrap: word-wrap; }
                if root.asks-name: LineEdit {
                    text <=> root.value;
                    accepted => { if root.value != "" { root.accepted(root.value); } }
                    init => { self.focus(); }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    Button { text: @tr("Cancel"); clicked => { root.cancelled(); } }
                    Button {
                        text: root.confirm-label;
                        primary: !root.destructive;
                        enabled: !root.asks-name || root.value != "";
                        clicked => { root.accepted(root.value); }
                    }
                }
            }
        }
    }
}

component AboutDialog inherits Rectangle {
    in property <string> version;
    in property <image> icon;
    in property <bool> has-icon;
    callback close();
    callback open-website();
    background: Theme.scrim;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: 340px;
        height: about-box.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 30px;
        drop-shadow-color: Theme.shadow;
        TouchArea { }
        about-box := VerticalLayout {
            padding: 28px;
            padding-bottom: 22px;
            spacing: 6px;
            HorizontalLayout {
                alignment: center;
                AppTile { size: 76px; icon: root.icon; has-icon: root.has-icon; }
            }
            Rectangle { height: 8px; }
            Text { text: Brand.name; font-size: Theme.font-heading; font-weight: 800; color: Theme.text-strong; horizontal-alignment: center; }
            Text { text: @tr("Version {}", root.version); font-size: Theme.font-small; color: Theme.text-muted; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: link-text.preferred-width + 12px;
                    height: 24px;
                    border-radius: Theme.radius-small;
                    background: link-touch.has-hover ? Theme.hover : transparent;
                    accessible-role: button;
                    accessible-label: Brand.website-label;
                    accessible-action-default => { root.open-website(); }
                    link-text := Text {
                        text: Brand.website-label;
                        font-size: Theme.font-small;
                        color: Theme.accent-text;
                    }
                    link-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-website(); } }
                }
            }
            Rectangle { height: 6px; }
            Text {
                text: Brand.tagline;
                font-size: Theme.font-body;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
                line-height-factor: 1.35;
            }
            Rectangle { height: 10px; }
            Rectangle { height: 1px; background: Theme.border; }
            Rectangle { height: 10px; }
            Text {
                text: @tr("Games and saves from RomM. Emulation by libretro cores and xemu.");
                font-size: Theme.font-caption;
                color: Theme.text-muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Rectangle { height: 12px; }
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                Button { text: @tr("GitHub"); clicked => { root.open-website(); } }
                Button { text: @tr("Close"); primary: true; clicked => { root.close(); } }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: Brand.name;
    icon: @image-url("icons/app-icon.png");
    background: Theme.background;
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 520px;
    min-height: 400px;

    in property <int> screen;
    property <bool> narrow;
    changed width => { self.narrow = self.width < 1000px; }
    init => { self.narrow = self.width < 1000px; }

    in-out property <string> server-url;
    in property <string> connect-error;
    in property <bool> busy;
    callback connect();

    in property <image> qr;
    in property <string> pair-link;
    in property <string> user-code;
    in-out property <int> seconds-left;
    in property <string> pair-status;
    in property <bool> pair-failed;
    callback copy-link();
    callback open-link();
    callback cancel-pairing();
    callback retry-pairing();

    in property <string> user-label;
    in property <image> user-avatar;
    in property <bool> has-user-avatar;
    in property <string> user-initial;
    in property <string> server-label;
    in property <string> heading: @tr("All games");
    in property <string> heading-detail;
    in property <image> app-icon: @image-url("icons/app-icon.png");
    in property <bool> has-app-icon: true;
    in property <string> app-version;
    in-out property <bool> about-open;
    callback open-url(string);
    callback sign-out();
    callback open-settings();
    in-out property <int> settings-section;
    in property <string> settings-server;
    in property <[DeviceRow]> settings-devices;
    in property <[KeyHint]> settings-keys;
    in property <[StorageRow]> settings-storage;
    in property <string> settings-storage-total;
    in property <bool> settings-storage-busy;
    callback assign-player(string, int);
    callback clear-images();
    callback show-folder();
    callback settings-section-changed(int);
    in-out property <bool> pref-pause-unfocused;
    in-out property <bool> pref-resume;
    in-out property <bool> pref-fullscreen;
    in-out property <bool> pref-sharp;
    in-out property <float> pref-volume;
    in-out property <int> pref-ui-scale;
    callback prefs-changed();
    in-out property <bool> pref-nintendo-labels;
    in-out property <bool> pref-stick-dpad;
    callback controller-options-changed();
    in property <bool> remap-open;
    in property <string> remap-title;
    in property <string> remap-hint;
    in property <bool> remap-waiting;
    in property <[RemapRow]> remap-rows;
    callback customize(string);
    callback remap-pick(int);
    callback remap-key(string);
    callback remap-reset();
    callback remap-close();

    in property <[SidebarEntry]> sidebar;
    in property <string> selected-key: "all";
    in property <[GameRow]> rows;
    in property <string> sync-status;
    in property <bool> syncing;
    in-out property <string> search;
    callback select(string);
    callback toggle-section(string);
    callback new-collection();
    callback rename-collection(string);
    callback delete-collection(string);
    callback search-edited(string);
    callback columns-changed(int);
    callback row-shown(int);
    callback refresh();
    callback open-game(int);

    in property <string> game-title;
    in property <string> game-category;
    in property <string> game-subtitle;
    in property <string> game-summary;
    in property <[Fact]> game-facts;
    in property <[Shot]> game-shots;
    in property <[GameCard]> game-similar;
    in property <float> game-similar-shelf: 230;
    in property <image> game-cover;
    in property <float> game-cover-aspect: 0.71;
    in property <bool> has-game-cover;
    in property <bool> game-downloaded;
    in property <bool> game-busy;
    in property <bool> game-playable;
    in property <bool> game-can-download;
    in property <float> game-progress;
    in property <string> game-status;
    callback back-to-library();
    callback download-game();
    callback cancel-download();
    callback play-game();
    callback delete-game();
    in property <bool> save-conflict;
    in property <string> conflict-text;
    callback keep-local-save();
    callback keep-server-save();
    in property <bool> needs-pairing;
    in property <string> pair-prompt;
    callback pair-again();
    in property <bool> show-collections;
    in property <bool> can-edit-collections;
    in property <bool> game-favorite;
    in property <[Membership]> game-memberships;
    callback toggle-favorite();
    callback toggle-membership(string, bool);
    callback new-collection-with-game();
    in property <int> grid-focus-row: -1;
    in-out property <length> grid-scroll <=> library.scroll-y;
    in property <float> grid-focus-top;
    in property <float> grid-focus-bottom;
    in property <string> pad-hints;
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-message;
    in property <bool> dialog-asks-name;
    in-out property <string> dialog-value;
    in property <string> dialog-confirm;
    in property <bool> dialog-destructive;
    callback dialog-accepted(string);
    callback dialog-cancelled();
    in-out property <bool> downloaded-only;
    in property <bool> offline;
    in-out property <int> sort-index;
    callback sort-changed(int);
    callback downloaded-only-toggled(bool);

    MenuBar {
        Menu {
            title: @tr("Library");
            MenuItem {
                title: @tr("Search");
                shortcut: @keys(Control + F);
                enabled: root.screen == 2 || root.screen == 3;
                activated => {
                    if root.screen != 2 { root.back-to-library(); }
                    library.focus-search();
                }
            }
            MenuItem {
                title: @tr("Refresh");
                shortcut: @keys(Control + R);
                enabled: root.screen >= 2 && !root.syncing && !root.offline;
                activated => { root.refresh(); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Settings…");
                shortcut: @keys(Control + Comma);
                enabled: root.screen >= 2 && root.screen != 4;
                activated => { root.open-settings(); }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("About {}", Brand.name);
                activated => { root.about-open = true; }
            }
            MenuItem {
                title: @tr("{} on GitHub", Brand.name);
                activated => { root.open-url(Brand.website); }
            }
        }
    }

    if root.screen == 0: Connect {
        server-url <=> root.server-url;
        error: root.connect-error;
        busy: root.busy;
        connect => { root.connect(); }
    }
    if root.screen == 1: Pairing {
        qr: root.qr;
        link: root.pair-link;
        user-code: root.user-code;
        seconds-left: root.seconds-left;
        status: root.pair-status;
        failed: root.pair-failed;
        copy-link => { root.copy-link(); }
        open-link => { root.open-link(); }
        cancel => { root.cancel-pairing(); }
        retry => { root.retry-pairing(); }
    }
    library := Library {
        visible: root.screen >= 2 && root.screen <= 4;
        compact: root.narrow;
        page-open: root.screen == 3 || root.screen == 4;
        user-label: root.user-label;
        sidebar: root.sidebar;
        selected-key: root.selected-key;
        rows: root.rows;
        sync-status: root.sync-status;
        syncing: root.syncing;
        search <=> root.search;
        select(key) => { root.select(key); }
        toggle-section(key) => { root.toggle-section(key); }
        new-collection => { root.new-collection(); }
        rename-collection(key) => { root.rename-collection(key); }
        delete-collection(key) => { root.delete-collection(key); }
        search-edited(text) => { root.search-edited(text); }
        columns-changed(n) => { root.columns-changed(n); }
        row-shown(i) => { root.row-shown(i); }
        refresh => { root.refresh(); }
        open-game(id) => { root.open-game(id); }
        needs-pairing: root.needs-pairing;
        pair-prompt: root.pair-prompt;
        pair-again => { root.pair-again(); }
        downloaded-only <=> root.downloaded-only;
        offline: root.offline;
        downloaded-only-toggled(on) => { root.downloaded-only-toggled(on); }
        sort-index <=> root.sort-index;
        sort-changed(i) => { root.sort-changed(i); }
        open-settings => { root.open-settings(); }
        focus-row: root.grid-focus-row;
        focus-top: root.grid-focus-top * 1px;
        focus-bottom: root.grid-focus-bottom * 1px;
        user-initial: root.user-initial;
        user-avatar: root.user-avatar;
        has-user-avatar: root.has-user-avatar;
        server-label: root.server-label;
        heading: root.heading;
        heading-detail: root.heading-detail;
        app-icon: root.app-icon;
        has-app-icon: root.has-app-icon;
        open-about => { root.about-open = true; }
        if root.screen == 3: GamePage {
            back-label: root.heading;
            title: root.game-title;
            category: root.game-category;
            subtitle: root.game-subtitle;
            summary: root.game-summary;
            facts: root.game-facts;
            shots: root.game-shots;
            similar: root.game-similar;
            similar-shelf: root.game-similar-shelf;
            open-game(id) => { root.open-game(id); }
            cover: root.game-cover;
            cover-aspect: root.game-cover-aspect;
            has-cover: root.has-game-cover;
            downloaded: root.game-downloaded;
            busy: root.game-busy;
            playable: root.game-playable;
            can-download: root.game-can-download;
            progress: root.game-progress;
            status: root.game-status;
            back => { root.back-to-library(); }
            download => { root.download-game(); }
            cancel => { root.cancel-download(); }
            play => { root.play-game(); }
            delete => { root.delete-game(); }
            conflict: root.save-conflict;
            conflict-text: root.conflict-text;
            keep-local => { root.keep-local-save(); }
            keep-server => { root.keep-server-save(); }
            show-collections: root.show-collections;
            can-edit-collections: root.can-edit-collections;
            favorite: root.game-favorite;
            memberships: root.game-memberships;
            toggle-favorite => { root.toggle-favorite(); }
            toggle-membership(key, on) => { root.toggle-membership(key, on); }
            new-collection => { root.new-collection-with-game(); }
        }
        if root.screen == 4: SettingsPage {
            back-label: root.heading;
            remap-open: root.remap-open;
            section <=> root.settings-section;
            user: root.user-label;
            server: root.settings-server;
            offline: root.offline;
            devices: root.settings-devices;
            keys: root.settings-keys;
            storage: root.settings-storage;
            storage-total: root.settings-storage-total;
            storage-busy: root.settings-storage-busy;
            pause-unfocused <=> root.pref-pause-unfocused;
            resume <=> root.pref-resume;
            fullscreen <=> root.pref-fullscreen;
            sharp <=> root.pref-sharp;
            volume <=> root.pref-volume;
            ui-scale <=> root.pref-ui-scale;
            prefs-changed => { root.prefs-changed(); }
            nintendo-labels <=> root.pref-nintendo-labels;
            stick-dpad <=> root.pref-stick-dpad;
            controller-options-changed => { root.controller-options-changed(); }
            customize(key) => { root.customize(key); }
            back => { root.back-to-library(); }
            sign-out => { root.sign-out(); }
            pair-again => { root.pair-again(); }
            assign(key, player) => { root.assign-player(key, player); }
            clear-images => { root.clear-images(); }
            show-folder => { root.show-folder(); }
            section-changed(i) => { root.settings-section-changed(i); }
        }
    }
    if root.remap-open: RemapDialog {
        title: root.remap-title;
        hint: root.remap-hint;
        waiting: root.remap-waiting;
        rows: root.remap-rows;
        pick(i) => { root.remap-pick(i); }
        key(text) => { root.remap-key(text); }
        reset => { root.remap-reset(); }
        close => { root.remap-close(); }
    }
    if root.pad-hints != "" && !root.dialog-open: Rectangle {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 12px;
        width: hints-text.preferred-width + 24px;
        height: 30px;
        border-radius: 15px;
        background: Theme.scrim-strong;
        border-width: 1px;
        border-color: Theme.border-subtle;
        hints-text := Text { text: root.pad-hints; color: Theme.text-secondary; font-size: Theme.font-small; }
    }
    if root.about-open: AboutDialog {
        version: root.app-version;
        icon: root.app-icon;
        has-icon: root.has-app-icon;
        close => { root.about-open = false; }
        open-website => { root.open-url(Brand.website); }
    }
    if root.dialog-open: Dialog {
        title: root.dialog-title;
        message: root.dialog-message;
        asks-name: root.dialog-asks-name;
        value <=> root.dialog-value;
        confirm-label: root.dialog-confirm;
        destructive: root.dialog-destructive;
        accepted(value) => { root.dialog-accepted(value); }
        cancelled => { root.dialog-cancelled(); }
    }
}
