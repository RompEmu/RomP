import { Palette } from "std-widgets.slint";
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/Inter-ExtraBold.ttf";
import "fonts/IBMPlexSansArabic-Regular.ttf";
import "fonts/IBMPlexSansArabic-Medium.ttf";
import "fonts/IBMPlexSansArabic-SemiBold.ttf";
import "fonts/IBMPlexSansArabic-Bold.ttf";

export global Theme {
    // Slint's own widgets follow the system, or the scheme chosen in Settings; their palette's
    // background tells which one is showing, so RomP's colours match them.
    out property <bool> dark: Palette.background == #1c1c1c;

    out property <color> background: root.dark ? #15171c : #f4f5f7;
    out property <color> sidebar: root.dark ? #111317 : #eceef1;
    out property <color> surface: root.dark ? #1c1f26 : #ffffff;
    out property <color> surface-raised: root.dark ? #23272f : #ffffff;
    out property <color> surface-muted: root.dark ? #2a2e36 : #e9ecf0;
    out property <color> surface-selected: root.dark ? #3a3f4b : #dbe0e7;
    out property <color> hover: root.dark ? #ffffff0d : #0000000d;
    out property <color> pressed: root.dark ? #ffffff1f : #0000001f;
    out property <color> border: root.dark ? #2a2f38 : #d5dae1;
    out property <color> border-subtle: root.dark ? #ffffff1a : #0000001a;
    out property <color> divider: root.dark ? #20242b : #e3e6ea;
    out property <color> scrim: root.dark ? #000000a8 : #00000080;
    out property <color> scrim-strong: root.dark ? #000000c8 : #000000c8;
    out property <color> shadow: root.dark ? #00000090 : #00000038;

    out property <color> text-strong: root.dark ? #ffffff : #0b0d10;
    out property <color> text: root.dark ? #e6e8eb : #1c2026;
    out property <color> text-secondary: root.dark ? #c2c7cf : #3a414b;
    out property <color> text-muted: root.dark ? #8a8f98 : #5c636d;
    out property <color> text-subtle: root.dark ? #6b7280 : #767d87;

    out property <brush> accent: Palette.accent-background;
    out property <brush> accent-hover: Palette.accent-background.brighter(0.15);
    out property <brush> accent-pressed: Palette.accent-background.darker(0.15);
    out property <brush> accent-foreground: Palette.accent-foreground;
    out property <brush> accent-soft: Palette.accent-background.with-alpha(0.16);
    out property <brush> accent-soft-strong: Palette.accent-background.with-alpha(0.28);
    out property <brush> accent-text: root.dark ? Palette.accent-background.brighter(0.5) : Palette.accent-background.darker(0.2);

    out property <color> success: root.dark ? #3fbf6b : #1d8a4b;
    out property <color> warning: root.dark ? #f0a33c : #a96300;
    out property <color> warning-surface: root.dark ? #3b2f1e : #fbecd5;
    out property <color> danger: root.dark ? #e5484d : #cf2f35;
    out property <color> favorite: root.dark ? #ff5c7a : #d92c52;

    out property <length> font-caption: 11px;
    out property <length> font-small: 12px;
    out property <length> font-body: 13px;
    out property <length> font-body-large: 14px;
    out property <length> font-subtitle: 16px;
    out property <length> font-title: 20px;
    out property <length> font-heading: 24px;
    out property <length> font-display: 32px;

    out property <length> radius-small: 6px;
    out property <length> radius: 8px;
    out property <length> radius-large: 12px;
}

/// Which way the interface reads; right to left in Arabic.
export global Locale {
    in property <bool> rtl;
    out property <TextHorizontalAlignment> start: rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    out property <TextHorizontalAlignment> end: rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
    /// Inter, or IBM Plex Sans Arabic in Arabic, which carries Latin letters to match.
    out property <string> font: rtl ? "IBM Plex Sans Arabic" : "Inter";
}

/// A row whose items run right to left in Arabic, otherwise like a HorizontalLayout.
export component Row inherits FlexboxLayout {
    flex-direction: Locale.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
    flex-wrap: FlexboxLayoutWrap.no-wrap;
    alignment: LayoutAlignment.stretch;
}
