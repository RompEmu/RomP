msgid "Code"
msgstr "الكود"

#: crates/romp-app/ui/app.slint
msgid "Open in browser"
msgstr "فتح في المتصفح"

#: crates/romp-app/ui/app.slint
msgid "Copy link"
msgstr "نسخ الرابط"

#: crates/romp-app/ui/app.slint
msgid "Waiting for approval… ({}:{}{})"
msgstr "في انتظار الموافقة… ({}:{}{}})"

